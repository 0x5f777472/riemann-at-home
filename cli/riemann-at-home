def compiled_sizes(lib: Path) -> dict:
    """Finished modules (.olean + .trace) -> size of the .olean."""
    out = {}
    for root, _, files in os.walk(lib):
        rel = os.path.relpath(root, lib)
        fs = set(files)
        for f in files:
            if f.endswith(".olean") and f[:-6] + ".trace" in fs:
                name = (f[:-6] if rel == "." else f"{rel}/{f[:-6]}").replace(os.sep, ".")
                out[name] = os.path.getsize(os.path.join(root, f))
    return out


def compiling_now(ctx: Ctx) -> list:
    """(module, seconds so far) for each lean process compiling a file of this folder right now."""
    ps = subprocess.run(["ps", "-axo", "etime=,command="], capture_output=True, text=True).stdout
    src = f"{ctx.folder}/src/"
    out = []
    for line in ps.splitlines():
        et, _, cmd = line.strip().partition(" ")
        if "/lean " not in cmd or src not in cmd:
            continue
        i = cmd.index(src) + len(src)
        j = cmd.find(".lean", i)
        if j < 0:
            continue
        d, _, hms = et.rpartition("-")
        try:
            parts = [int(x) for x in hms.split(":")]
            secs = (int(d) * 86400 if d else 0) + sum(v * 60 ** k for k, v in enumerate(reversed(parts)))
        except ValueError:
            secs = 0
        out.append((cmd[i:j].replace("/", "."), secs))
    return out


def parse_secs(t: str):
    """Lake's durations: `805ms`, `24s`, `1.2s`, `1m 3s`, `2h 1m`."""
    total, ok = 0.0, False
    for v, u in re.findall(r"([\d.]+)\s*(ms|h|m|s)", t):
        total += float(v) * {"ms": 0.001, "s": 1, "m": 60, "h": 3600}[u]
        ok = True
    return round(total, 1) if ok else None


BUILT = re.compile(r"Built (\S+) \(([^)]*)\)")


def build_times(ctx: Ctx) -> dict:
    """Module -> seconds it took, from the build log (the last time it was built)."""
    out = {}
    try:
        with open(ctx.logs / "build.log", errors="replace") as f:
            for line in f:
                m = BUILT.search(line)
                if m and ":" not in m[1]:
                    sec = parse_secs(m[2])
                    if sec is not None:
                        out[m[1]] = sec
    except OSError:
        pass
    return out


def page_data(ctx: Ctx):
    """data.json for the local page: one byte per module (0 = not compiled, else the log-scaled size of its
    compiled file), library and folder boundaries, what is compiling now, when this build started."""
    mods = all_modules(ctx.folder)
    local = compiled_sizes(ctx.lib) if ctx.lib.exists() else {}
    lo, hi = math.log(1e3), math.log(5e7)
    local_b = bytes(0 if m not in local else
                    max(1, min(255, 1 + round(254 * (math.log(max(local[m], 1e3)) - lo) / (hi - lo)))) for m in mods)
    index = {m: i for i, m in enumerate(mods)}

    def bounds(depth):
        out, prev = [], None
        for i, m in enumerate(mods):
            k = ".".join(m.split(".")[:depth])
            if k != prev:
                out.append([k, i]); prev = k
        return out
    active = [m for m, _ in compiling_now(ctx) if m in index]
    started, _ = busy_seconds(ctx, bool(supervisor(ctx)))
    data = {"terrain": {"n": len(mods), "libraries": bounds(1), "folders": bounds(2),
                        "local_b64": base64.b64encode(local_b).decode(), "local_compiled": len(local),
                        "local_started": iso(started) if started else None,
                        "active": [index[m] for m in active], "active_names": active,
                        "generated": iso(time.time())}}
    return data, mods


def write_page(ctx: Ctx) -> Path:
    """index.html + data.json + modules.txt into ~/.riemann-at-home/page/, which is what gets served."""
    if not PAGE_TEMPLATE.exists():
        raise Fail(f"page template missing: {PAGE_TEMPLATE} (it ships in the page/ folder next to this tool)")
    out = ctx.home / "page"
    out.mkdir(parents=True, exist_ok=True)
    data, mods = page_data(ctx)
    for name, text in (("index.html", PAGE_TEMPLATE.read_text()), ("modules.txt", "\n".join(mods) + "\n"),
                       ("data.json", json.dumps(data))):
        tmp = out / (name + ".tmp")
        tmp.write_text(text)
        tmp.replace(out / name)
    return out


class Live:
    """live.json: what this computer's build is doing now. The folder walk runs at most every 15 s."""
    def __init__(self, ctx):
        self.ctx, self.lock, self.count, self.count_at = ctx, threading.Lock(), 0, 0.0
        self.times, self.times_size = {}, -1

    def get(self) -> dict:
        ctx = self.ctx
        with self.lock:
            if time.time() - self.count_at > 15:
                self.count, self.count_at = (count_compiled(ctx.lib) if ctx.lib.exists() else 0), time.time()
        sup = supervisor(ctx)
        running = bool(sup) or bool(outside_build(ctx))
        paused = bool(sup) and is_paused(ctx)
        started = next((t for k, _, t in reversed(events(ctx)) if k in ("START", "RESTART")), None) if running else None
        recent = []
        try:
            with open(ctx.logs / "build.log", "rb") as f:
                f.seek(max(0, f.seek(0, 2) - 20000))
                for m in BUILT.finditer(f.read().decode(errors="replace")):
                    if ":" not in m[1] and parse_secs(m[2]) is not None:
                        recent.append([m[1], parse_secs(m[2])])
        except OSError:
            pass
        r = rate_per_hour(ctx)
        return {"compiled": self.count, "running": running, "paused": paused,
                "mode": "paused" if paused else stored_mode(ctx), "ours": bool(sup),
                "started": iso(started) if started else None, "rate": round(r) if r else None,
                "active": [{"name": m, "secs": s} for m, s in compiling_now(ctx)], "recent": recent[-5:]}

    def build_times(self) -> dict:
        try:
            size = (self.ctx.logs / "build.log").stat().st_size
        except OSError:
            return {}
        if size != self.times_size:
            self.times, self.times_size = build_times(self.ctx), size
        return self.times


def set_mode_from_page(ctx: Ctx, mode: str):
    """The page's Full / Gentle / Pause buttons. Only for a build this tool started."""
    if not supervisor(ctx):
        raise Fail("no build started by riemann-at-home is running")
    ns = argparse.Namespace(gentle=mode == "gentle", full=mode == "full", target="Main", submit_repo=None,
                            test_unofficial_folder=False)
    if mode == "paused":
        return cmd_pause(ctx, ns)
    if is_paused(ctx):
        cmd_resume(ctx, ns)
    return cmd_build(ctx, ns)


def make_handler(ctx: Ctx, root: Path, live: Live):
    class H(http.server.SimpleHTTPRequestHandler):
        def __init__(self, *x, **k):
            super().__init__(*x, directory=str(root), **k)

        def log_message(self, *x):
            pass

        def send_json(self, obj, code=200):
            b = json.dumps(obj).encode()
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(b)))
            self.end_headers()
            self.wfile.write(b)

        def do_GET(self):
            path = self.path.split("?")[0]
            if path == "/live.json":
                return self.send_json(live.get())
            if path == "/times.json":
                return self.send_json(live.build_times())
            return super().do_GET()

        def do_POST(self):
            # only this page may switch the build's speed: same-host request carrying our header
            host = (self.headers.get("Host") or "").split(":")[0]
            if self.path != "/mode" or self.headers.get("X-Riemann-At-Home") != "1" or host not in ("localhost", "127.0.0.1"):
                return self.send_json({"error": "forbidden"}, 403)
            try:
                n = min(int(self.headers.get("Content-Length") or 0), 1000)
                mode = json.loads(self.rfile.read(n) or b"{}").get("mode")
                if mode not in ("full", "gentle", "paused"):
                    return self.send_json({"error": "mode must be full, gentle or paused"}, 400)
                with contextlib.redirect_stdout(io.StringIO()):
                    set_mode_from_page(ctx, mode)
            except Fail as e:
                return self.send_json({"error": str(e)}, 409)
            except (ValueError, AttributeError):
                return self.send_json({"error": "bad request"}, 400)
            return self.send_json(live.get())
    return H


def cmd_page(ctx: Ctx, a):
    root = write_page(ctx)
    url = f"http://localhost:{a.port}/"
    if a.once:
        print(f"page written to {root}\n{url}  (run `riemann-at-home page` to serve it)")
        return 0
    try:
        srv = http.server.ThreadingHTTPServer(("127.0.0.1", a.port), make_handler(ctx, root, Live(ctx)))
    except OSError:
        raise Fail(f"port {a.port} is busy (is the page already being served?). Try: riemann-at-home page --port 8643")

    def refresher():                       # new spikes: regenerate data.json every minute
        while True:
            time.sleep(60)
            try:
                write_page(ctx)
            except Exception as e:         # keep serving
                print(f"refresh failed: {e}", file=sys.stderr)
    threading.Thread(target=refresher, daemon=True).start()
    print(f"serving {url} (this computer only; Ctrl-C to stop)")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


# ---------------------------------------------------------------- main

def main(argv=None):
    hidden = argparse.ArgumentParser(add_help=False)
    hidden.add_argument("--folder", help=argparse.SUPPRESS)        # testing: a build folder other than the fixed one
    hidden.add_argument("--logs", help=argparse.SUPPRESS)          # testing / logs of an older build script
    ap = argparse.ArgumentParser(prog="riemann-at-home", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--version", action="version", version=TOOL)
    sub = ap.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("setup", parents=[hidden], help="download, verify, unpack; install Lean + Mathlib cache")
    s.add_argument("--archive", help="use this local lean.tar.gz instead of downloading")
    s.add_argument("--parts-url", default=PART_URL, help=argparse.SUPPRESS)
    s.add_argument("--skip-cache", action="store_true", help=argparse.SUPPRESS)
    s.add_argument("--force-cache", action="store_true", help=argparse.SUPPRESS)
    for name, h in (("build", "start the official build in the background, or change its speed"),
                    ("resume", "continue a paused build (or start a stopped one)")):
        b = sub.add_parser(name, parents=[hidden], help=h)
        g = b.add_mutually_exclusive_group()
        g.add_argument("--gentle", action="store_true", help="background priority: only spare CPU (default)")
        g.add_argument("--full", action="store_true", help="all cores (still lowest priority, nice 19)")
        b.add_argument("--target", default="Main", help=argparse.SUPPRESS)
        b.add_argument("--submit-repo", help="clone of the Riemann@home repo: update this build's PR about every 10 min")
        b.add_argument("--test-unofficial-folder", action="store_true", help=argparse.SUPPRESS)
    sub.add_parser("pause", parents=[hidden], help="freeze the build in place")
    sub.add_parser("stop", parents=[hidden], help="stop the build (resumable)")
    sub.add_parser("status", parents=[hidden], help="progress, running or not, speed")
    r = sub.add_parser("record", parents=[hidden], help="write a build record to ~/.riemann-at-home/records/")
    r.add_argument("--test-unofficial-folder", action="store_true", help=argparse.SUPPRESS)
    u = sub.add_parser("submit", parents=[hidden], help="open a pull request with your latest build record")
    u.add_argument("--repo", required=True, help="your local clone of the Riemann@home repo")
    u.add_argument("--record", help="record file (default: the latest)")
    u.add_argument("--login", help="GitHub login (default: from `gh`)")
    u.add_argument("--upstream", help="OWNER/REPO to open the PR against (default: origin)")
    u.add_argument("--dry-run", action="store_true", help="print what it would do; change nothing")
    u.add_argument("--no-gh-check", action="store_true", help=argparse.SUPPRESS)
    f = sub.add_parser("finish", parents=[hidden], help="done on this computer: final record, PR gets merged")
    f.add_argument("--repo", help="your local clone of the Riemann@home repo (submits the final record)")
    f.add_argument("--login"); f.add_argument("--upstream")
    f.add_argument("--dry-run", action="store_true", help="print what it would do; change nothing")
    f.add_argument("--no-gh-check", action="store_true", help=argparse.SUPPRESS)
    f.add_argument("--test-unofficial-folder", action="store_true", help=argparse.SUPPRESS)
    nm = sub.add_parser("name", parents=[hidden], help="the name the page shows instead of your GitHub login")
    nm.add_argument("display_name", nargs="?", help="1 to 32 characters")
    g = nm.add_mutually_exclusive_group()
    g.add_argument("--anonymous", action="store_true", help="show as anonymous")
    g.add_argument("--clear", action="store_true", help="show your GitHub login again")
    p = sub.add_parser("page", parents=[hidden], help="regenerate the local page and serve it on localhost:8642")
    p.add_argument("--once", action="store_true", help="regenerate only, don't serve")
    p.add_argument("--port", type=int, default=PAGE_PORT, help=f"local port (default {PAGE_PORT})")
    lvl = argparse.ArgumentParser(add_help=False)
    lvl.add_argument("--exporter", help=argparse.SUPPRESS)            # testing: a stand-in for lean4export
    lvl.add_argument("--test-unofficial-folder", action="store_true", help=argparse.SUPPRESS)
    sub.add_parser("export", parents=[hidden, lvl],
                   help="Level 2: hash the proof export (lean4export, streamed, never stored) against the reference")
    rc = sub.add_parser("recheck", parents=[hidden, lvl], help="Level 3 (optional): re-check the export independently")
    g = rc.add_mutually_exclusive_group(required=True)
    g.add_argument("--nanoda", action="store_true", help=f"nanoda (needs about {CHECKERS['nanoda']} GB of memory)")
    g.add_argument("--con-leche", action="store_true", help=f"con-leche (needs about {CHECKERS['con-leche']} GB of memory)")
    rc.add_argument("--checker", help="path to the checker binary (default: on PATH or ~/.riemann-at-home/tools/bin)")
    rc.add_argument("--checker-args", help="extra arguments for the checker (it reads the export on stdin)")
    rc.add_argument("--checker-version", help="version to record (default: `CHECKER --version`)")
    sub.add_parser("sign", parents=[hidden, lvl], help="sign the joint statement (Level 2 or 3)")
    x = sub.add_parser("_run", parents=[hidden])   # internal: the background supervisor
    x.add_argument("--target", default="Main")
    x.add_argument("--test-unofficial-folder", action="store_true")
    a = ap.parse_args(argv)
    try:
        ctx = Ctx(a)
        fn = {"setup": cmd_setup, "build": cmd_build, "pause": cmd_pause, "resume": cmd_resume, "stop": cmd_stop,
              "status": cmd_status, "record": cmd_record, "finish": cmd_finish, "name": cmd_name, "submit": cmd_submit, "page": cmd_page,
              "export": cmd_export, "recheck": cmd_recheck, "sign": cmd_sign, "_run": cmd_run}[a.cmd]
        return fn(ctx, a) or 0
    except Fail as e:
        print(f"riemann-at-home: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
