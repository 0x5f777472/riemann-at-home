    if folder.exists():
        tc = toolchain_of(folder)
        if tc != TOOLCHAIN:
            raise Fail(f"{folder} exists but pins {tc or 'no toolchain'}, expected {TOOLCHAIN}. "
                       "Move it aside and run setup again.")
        if mathlib_rev_of(folder) != MATHLIB_REV:
            raise Fail(f"{folder} pins Mathlib {mathlib_rev_of(folder)}, expected {MATHLIB_REV}")
        print(f"[1/3] proof folder already here with {TOOLCHAIN}: {folder} (skipping download)")
    else:
        if a.archive:
            archive = Path(a.archive).expanduser()
            print(f"[1/3] checking {archive}")
            if sha256_file(archive) != ARCHIVE_SHA256:
                raise Fail(f"{archive} does not have sha256 {ARCHIVE_SHA256}")
        else:
            print(f"[1/3] downloading the official archive ({PARTS} parts, {ARCHIVE_BYTES / 1e6:.0f} MB)")
            archive = download_archive(ctx, a.parts_url)
        print(f"      sha256 {ARCHIVE_SHA256} ok; unpacking into {folder}")
        unpack(archive, folder)
        if toolchain_of(folder) != TOOLCHAIN:
            raise Fail(f"unpacked archive pins {toolchain_of(folder)}, expected {TOOLCHAIN}")
    elan = ensure_elan()
    if toolchain_installed(elan):
        print(f"[2/3] Lean {TOOLCHAIN} already installed")
    else:
        print(f"[2/3] installing Lean {TOOLCHAIN}")
        if run([elan, "toolchain", "install", TOOLCHAIN], env=lean_env()).returncode != 0:
            raise Fail("toolchain install failed")
    if mathlib_cache_present(folder) and not a.force_cache:
        print("[3/3] Mathlib compiled cache already here")
    elif a.skip_cache:
        print("[3/3] skipping Mathlib cache (--skip-cache)")
    else:
        print("[3/3] fetching Mathlib's compiled cache (lake exe cache get Mathlib)")
        if run([which("lake") or "lake", "exe", "cache", "get", "Mathlib"], cwd=folder, env=lean_env()).returncode != 0:
            raise Fail("`lake exe cache get Mathlib` failed; run setup again to retry")
    print(f"this computer's build_id: {ctx.build_id()}")
    print(f"ready. Next: riemann-at-home build")


# ---------------------------------------------------------------- build control

def free_gb(folder: Path) -> float:
    p = folder
    while not p.exists():
        p = p.parent
    return shutil.disk_usage(p).free / 1e9


def disk_message(ctx: Ctx) -> str:
    return (f"only {free_gb(ctx.folder):.1f} GB free on the build disk, so the build stopped to leave "
            f"{MIN_FREE_GB:g} GB for the rest of your computer (a whole build needs about {WHOLE_BUILD_GB} GB). "
            "Free some space, then `riemann-at-home build` continues from here. "
            "`record` and `submit` still work for what is built.")


def disk_heads_up(ctx: Ctx) -> None:
    """Said before setup and every build: what the whole thing takes, and what this computer can do."""
    folder = ctx.folder if ctx.folder.exists() else ctx.folder.parent
    while not folder.exists() and folder != folder.parent:
        folder = folder.parent
    free = shutil.disk_usage(folder).free / 1e9
    print(f"Heads up: building the whole proof takes about 2 days on a fast computer (a week or more on a laptop) and "
          f"needs about {WHOLE_BUILD_GB} GB of free disk. This computer has {free:.0f} GB free.")
    if free < WHOLE_BUILD_GB:
        print(f"That's not enough for the whole proof, and that's fine: the build stops by itself when "
              f"{MIN_FREE_GB:g} GB are left, so your computer always keeps room, and every module you built still "
              "counts on the leaderboard.")
    print("Pause any time with `riemann-at-home pause`; `riemann-at-home stop` keeps everything built so far.\n")


def stored_mode(ctx: Ctx) -> str:
    m = read(ctx.mode_file).strip()
    return m if m in ("gentle", "full") else "gentle"


def cmd_build(ctx: Ctx, a):
    mode = "full" if a.full else "gentle" if a.gentle else stored_mode(ctx)
    ctx.logs.mkdir(parents=True, exist_ok=True)
    sup = supervisor(ctx)
    if sup:
        if mode != stored_mode(ctx) or a.full or a.gentle:
            ctx.mode_file.write_text(mode)
            set_priority(build_pids(ctx), mode)
            log_event(ctx, f"MODE_{mode.upper()}")
            print(f"build already running (pid {sup}); speed set to {mode}")
        else:
            print(f"build already running (pid {sup}), {mode}")
        return 0
    other = outside_build(ctx)
    if other:
        raise Fail(f"another build is already running in {ctx.folder} (lake pid {', '.join(map(str, other))}), "
                   "not started by this tool. Stop that one first.")
    if toolchain_of(ctx.folder) != TOOLCHAIN:
        raise Fail(f"{ctx.folder} is not set up (expected lean-toolchain {TOOLCHAIN}); run: riemann-at-home setup")
    if not which("lake"):
        raise Fail("lake not found; run: riemann-at-home setup")
    if free_gb(ctx.folder) < MIN_FREE_GB:
        raise Fail(disk_message(ctx))
    disk_heads_up(ctx)
    if a.submit_repo:
        ctx.set_conf(repo=str(Path(a.submit_repo).expanduser().resolve()))
    ctx.mode_file.write_text(mode)
    cmd = [sys.executable, "-I", str(Path(__file__).resolve()), "_run", "--folder", str(ctx.folder),
           "--logs", str(ctx.logs), "--target", a.target] + (["--test-unofficial-folder"] if a.test_unofficial_folder else [])
    with open(ctx.logs / "supervisor.log", "ab") as lf:
        p = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=lf, stderr=lf, start_new_session=True,
                             env={**os.environ, "RAH_HOME": str(ctx.home)})
    for _ in range(100):
        if read_pid(ctx.pgid_file) and supervisor(ctx) == p.pid:
            break
        if p.poll() is not None:
            raise Fail(f"build failed to start; see {ctx.logs / 'supervisor.log'}")
        time.sleep(0.1)
    print(f"building `lake build {a.target}` in {ctx.folder} ({mode}), in the background.\n"
          f"  log: {ctx.logs / 'build.log'}\n  riemann-at-home status | pause | resume | stop")
    return 0


def cmd_run(ctx: Ctx, a):
    """The background supervisor: runs the official `lake build Main` unchanged (nice 19), then the axiom check."""
    ctx.logs.mkdir(parents=True, exist_ok=True)
    ctx.pid_file.write_text(str(os.getpid()))
    log_event(ctx, "RESTART" if any(k == "START" for k, _, _ in events(ctx)) else "START")
    if free_gb(ctx.folder) < MIN_FREE_GB:
        print(disk_message(ctx), flush=True)
        log_event(ctx, "DISK_LOW")
        log_event(ctx, "BUILD_EXIT=disk")
        ctx.pid_file.unlink(missing_ok=True)
        return 1
    mode = stored_mode(ctx)
    tcmd = (["/usr/bin/time", "-l"] if IS_MAC else ["/usr/bin/time", "-v"]) if Path("/usr/bin/time").exists() else []
    cmd = tcmd + ["nice", "-n", "19", which("lake") or "lake", "--no-ansi", "build", a.target]
    stopping, terminated, disk_low = threading.Event(), threading.Event(), threading.Event()
    with open(ctx.logs / "build.log", "ab") as out, open(ctx.logs / "time.txt", "ab") as err:
        p = subprocess.Popen(cmd, cwd=ctx.folder, stdin=subprocess.DEVNULL, stdout=out, stderr=err,
                             env=lean_env(), start_new_session=True)
    ctx.pgid_file.write_text(str(p.pid))
    start_caffeinate(ctx, p.pid)

    def on_term(sig, frm):
        terminated.set()
        for s in (signal.SIGCONT, signal.SIGTERM):
            try:
                os.killpg(p.pid, s)
            except OSError:
                pass
    signal.signal(signal.SIGTERM, on_term)
    signal.signal(signal.SIGINT, on_term)

    def sampler():                            # first sample now: the baseline for this session's speed
        while True:
            with open(ctx.samples, "a") as f:
                f.write(f"{iso(time.time())} modules={count_compiled(ctx.lib)}\n")
            if stopping.wait(SAMPLE_SECONDS):
                return
    threading.Thread(target=sampler, daemon=True).start()

    def disk_guard():                         # stop safely before the disk fills; everything built is kept
        while not stopping.wait(DISK_CHECK_SECONDS):
            if free_gb(ctx.folder) < MIN_FREE_GB:
                print(disk_message(ctx), flush=True)
                log_event(ctx, "DISK_LOW")
                disk_low.set()
                on_term(None, None)
                return
    threading.Thread(target=disk_guard, daemon=True).start()

    def progress():                           # refresh the record on this build's one PR about every 10 minutes
        while not stopping.wait(AUTOSUBMIT_SECONDS):
            autosubmit(ctx, a, "progress")
    threading.Thread(target=progress, daemon=True).start()
    if mode == "gentle":                      # new lean processes inherit lake's policy
        for _ in range(30):
            pids = build_pids(ctx)
            if pids:
                set_priority(pids, mode)
                break
            time.sleep(1)
    rc = p.wait()
    stopping.set()
    stop_caffeinate(ctx)
    log_event(ctx, f"BUILD_EXIT={rc}")
    final_submit = rc == 0 or disk_low.is_set()
    if rc == 0 and a.target == "Main" and not terminated.is_set():
        audit = ctx.home / "audit"
        audit.mkdir(parents=True, exist_ok=True)
        (audit / "Audit.lean").write_text(AUDIT_LEAN)
        with open(ctx.logs / "axioms.log", "wb") as f:
            r = subprocess.run([which("lake") or "lake", "--no-ansi", "env", "lean", f"--root={audit}",
                                str(audit / "Audit.lean")], cwd=ctx.folder, stdout=f, stderr=subprocess.STDOUT,
                               env=lean_env())
        log_event(ctx, f"AXIOMS_EXIT={r.returncode}")
    if final_submit:
        autosubmit(ctx, a, "final")
    ctx.pgid_file.unlink(missing_ok=True)
    ctx.pid_file.unlink(missing_ok=True)
    return rc


def autosubmit(ctx: Ctx, a, why: str):
    """Write a record and push it to this build's one PR (dry run only in this build), using the repo given
    with `build --submit-repo`.
    Output goes to logs/autosubmit.log. Never raises: the build goes on whatever happens here."""
    if AUTOSUBMIT == "off":
        return
    me = [sys.executable, "-I", str(Path(__file__).resolve())]
    loc = ["--folder", str(ctx.folder), "--logs", str(ctx.logs)]
    with open(ctx.logs / "autosubmit.log", "a") as f:
        f.write(f"--- autosubmit ({why}) {iso(time.time())}\n")
        f.flush()
        try:
            extra = ["--test-unofficial-folder"] if getattr(a, "test_unofficial_folder", False) else []
            r = subprocess.run(me + ["record"] + loc + extra, stdout=f, stderr=subprocess.STDOUT,
                               env={**os.environ, "RAH_HOME": str(ctx.home)}, timeout=6 * 3600)
            repo = ctx.conf().get("repo")
            if r.returncode == 0 and repo:
                subprocess.run(me + ["submit", "--repo", repo, "--dry-run"] + loc, stdout=f, stderr=subprocess.STDOUT,
                               env={**os.environ, "RAH_HOME": str(ctx.home)}, timeout=600)
            elif r.returncode == 0:
                f.write("no repo to submit to (set one with: riemann-at-home build --submit-repo DIR)\n")
        except Exception as e:
            f.write(f"autosubmit failed: {e}\n")


def need_running(ctx: Ctx) -> int:
    if not supervisor(ctx) or not read_pid(ctx.pgid_file):
        raise Fail("no build is running. Start one with: riemann-at-home build")
    return read_pid(ctx.pgid_file)


def cmd_pause(ctx: Ctx, a):
    pgid = need_running(ctx)
    if is_paused(ctx):
        print("already paused")
        return 0
    os.killpg(pgid, signal.SIGSTOP)
    stop_caffeinate(ctx)
    log_event(ctx, "PAUSE")
    print("paused: frozen in place, nothing is lost. riemann-at-home resume")
    return 0


def cmd_resume(ctx: Ctx, a):
    if not supervisor(ctx):
        print("no build running; starting it again (it picks up where it stopped)")
        a.gentle = a.full = False
        return cmd_build(ctx, a)
    pgid = need_running(ctx)
    os.killpg(pgid, signal.SIGCONT)
    if is_paused(ctx):
        start_caffeinate(ctx, pgid)
        log_event(ctx, "RESUME")
    print(f"resumed ({stored_mode(ctx)})")
    return 0


def cmd_stop(ctx: Ctx, a):
    sup = supervisor(ctx)
    if not sup:
        print("no build running")
        return 0
    if is_paused(ctx):
        log_event(ctx, "RESUME")
    log_event(ctx, "STOP_REQUESTED")
    os.kill(sup, signal.SIGTERM)
    for _ in range(300):
        if not pid_alive(sup):
            break
        time.sleep(0.1)
    else:
        pgid = read_pid(ctx.pgid_file)
        if pgid:
            try:
                os.killpg(pgid, signal.SIGKILL)
            except OSError:
                pass
    print("stopped. Everything compiled so far is kept; `riemann-at-home build` continues from here.")
    return 0


# ---------------------------------------------------------------- status

SPEED_WINDOW = 1800   # speed = modules finished in the last 30 minutes of samples


def session_samples(ctx: Ctx) -> list:
    """Samples grouped by build session (each START/RESTART opens one). Counts are totals in the folder, so
    only differences within a session measure work done; modules that were already there never count."""
    starts = sorted(t for k, _, t in events(ctx) if k in ("START", "RESTART"))
    groups = [[] for _ in range(len(starts) + 1)]
    for t, n in samples(ctx):
        i = sum(1 for st in starts if st <= t)
        groups[i].append((t, n))
    return [g for g in groups if g]


def rate_per_hour(ctx: Ctx):
    """Modules per hour over the current session's last SPEED_WINDOW seconds; None until measurable."""
    ss = session_samples(ctx)
    if not ss:
        return None
    cur = ss[-1]
    recent = [x for x in cur if x[0] >= cur[-1][0] - SPEED_WINDOW]
    if len(recent) < 2:
        recent = cur[-2:]
    if len(recent) < 2:
        return None
    (t0, n0), (t1, n1) = recent[0], recent[-1]
    if t1 - t0 < 60:
        return None
    return max(0, n1 - n0) / (t1 - t0) * 3600


def built_by_this_tool(ctx: Ctx) -> int:
    """Modules finished while builds were measured (sum over sessions of last minus first sample)."""
    return sum(max(0, g[-1][1] - g[0][1]) for g in session_samples(ctx))


def cmd_status(ctx: Ctx, a):
    done = count_compiled(ctx.lib) if ctx.lib.exists() else 0
    sup = supervisor(ctx)
    ev = events(ctx)
    print(f"folder    {ctx.folder}{'' if ctx.folder.exists() else '  (not set up: riemann-at-home setup)'}")
    print(f"compiled  {done:,} / {N_MODULES:,} modules ({100 * done / N_MODULES:.2f}%)")
    if sup:
        state = "PAUSED" if is_paused(ctx) else f"running, {stored_mode(ctx)}"
        active = len(build_pids(ctx, ("lean",)))
        print(f"build     {state} (pid {sup}, {active} modules compiling now)")
    elif outside_build(ctx):
        print(f"build     running, started outside this tool (lake pid {', '.join(map(str, outside_build(ctx)))}); "
              "pause/stop only control builds started with `riemann-at-home build`")
    else:
        last = next((raw for k, raw, _ in reversed(ev) if k == "BUILD_EXIT"), None)
        how = {"BUILD_EXIT=0": "finished"}.get(last, "stopped" + (f" ({last})" if last else ""))
        print(f"build     not running, {how}" if ev else "build     not started yet")
    started, busy = busy_seconds(ctx, bool(sup) or bool(outside_build(ctx)))
    if started:
        print(f"started   {iso(started)}, busy {busy / 3600:.1f} h")
    r = rate_per_hour(ctx)
    built = built_by_this_tool(ctx)
    if sup and is_paused(ctx):
        print("speed     paused")
    elif sup and r is None:
        print(f"speed     measuring (first reading about {SAMPLE_SECONDS / 60:.0f} min after the build started)")
    elif sup and r is not None:
        left = N_MODULES - done
        eta = f", about {left / r / 24:.1f} days to go at this speed" if r > 0 else ""
        print(f"speed     {r:,.0f} modules/hour over the last {SPEED_WINDOW // 60} min{eta}")
    elif built and busy >= 600:
        print(f"speed     {built / busy * 3600:,.0f} modules/hour on average ({built:,} built while measured)")
    ax = read(ctx.logs / "axioms.log")
    if ax:
        print(f"axioms    {parse_axioms(ax)}")
    ex = levels_state(ctx).get("export")
    if ex and ex.get("sha256") == EXPORT_SHA256:
        lv = levels_state(ctx)
        ok = [e["name"] for e in lv.get("checkers", []) if e.get("result") == "accept"]
        print(f"level     {3 if ok else 2}: export reproduces the reference" + (f", re-checked by {', '.join(ok)}" if ok else "")
              + (", joint statement signed" if lv.get("sign_statement") else ""))
    elif ex:
        print(f"export    sha256 {ex.get('sha256')} does not match the reference ({UNVERIFIED})")
    elif done == N_MODULES and parse_axioms(ax) is not None:
        print("level     1: whole proof built. Next: riemann-at-home export")
    return 0


# ---------------------------------------------------------------- record

def make_record(ctx: Ctx, a, final: bool = False) -> dict:
    folder = ctx.folder
    official = str(folder) == str(fixed_folder())
    if not official and not a.test_unofficial_folder:
        raise Fail(f"records come from the fixed folder {fixed_folder()} only (got {folder})")
    if toolchain_of(folder) != TOOLCHAIN:
        raise Fail(f"{folder} pins {toolchain_of(folder) or 'no toolchain'}, expected {TOOLCHAIN}")
    if mathlib_rev_of(folder) != MATHLIB_REV:
        raise Fail(f"{folder} pins Mathlib {mathlib_rev_of(folder)}, expected {MATHLIB_REV}")
    mods = all_modules(folder)
    if len(mods) != N_MODULES and not a.test_unofficial_folder:
        raise Fail(f"{folder}/src has {len(mods):,} modules, expected {N_MODULES:,}: not the official archive")
    done = compiled_modules(ctx.lib)
    bits = [m in done for m in mods]
    cache = HashCache(ctx.home / "olean-hashes.json")
    digest = olean_digest(ctx.lib, mods, bits, cache)
    cache.save()
    started, busy = busy_seconds(ctx, bool(supervisor(ctx)) or bool(outside_build(ctx)))
    n = sum(bits)
    if n == 0:
        raise Fail("nothing compiled yet, so there is nothing to record. Start with: riemann-at-home build")
    recorded = int(time.time())
    # Modules may predate this tool's logs (a folder built before, or by another script). `started` is the earlier
    # of the first logged start and the first finished module, so new-modules / (recorded - started) stays an
    # honest rate for the bot's speed check, even on a first record of a pre-built folder.
    first_trace = min((ctx.lib / (m.replace(".", "/") + ".trace")).stat().st_mtime for m, on in zip(mods, bits) if on)
    started = int(min(started if started is not None else first_trace, first_trace, recorded - 1))
    bid = ctx.build_id()
    kept = ctx.conf().get("started") or {}      # keep `started` steady across this build's records
    if kept.get("build_id") == bid and isinstance(kept.get("t"), int) and kept["t"] <= started:
        started = kept["t"]
    else:
        ctx.set_conf(started={"build_id": bid, "t": started})
    busy = max(0, min(busy, recorded - started))
    axioms = None
    if n == len(mods) and mods:
        axioms = parse_axioms(read(ctx.logs / "axioms.log"))
    rec = {
        "format": FORMAT,
        "tool": TOOL,
        "archive_sha256": ARCHIVE_SHA256,
        "toolchain": TOOLCHAIN,
        "mathlib_rev": MATHLIB_REV,
        "build_folder": str(folder) if official else "unofficial",
        "build_id": bid,
        "machine": machine(),
        "started": iso(started),
        "recorded": iso(recorded),
        "busy_seconds": busy,
        "modules_compiled": n,
        "bitmap_b64": encode_bitmap(bits),
        "olean_digest": digest,
        "whole_proof": axioms is not None,
        "axioms": axioms,
        "final": bool(final),
    }
    assert list(rec) == RECORD_KEYS
    shown = ctx.conf().get("display")
    if shown == {"anonymous": True}:
        rec["anonymous"] = True
    elif isinstance(shown, dict) and name_problem(shown.get("display_name")) is None:
        rec["display_name"] = shown["display_name"]
    rec.update(level_fields(ctx, rec))
    if official:
        errs = validate_record(rec)
        if errs:
            raise Fail("record failed its own check:\n  " + "\n  ".join(errs))
    return rec


KEEP_RECORDS = 50


def write_record(ctx: Ctx, rec: dict) -> Path:
    """records/<UTC time>.json locally (history; the repo keeps one file per build). Keeps the last 50."""
    ctx.records.mkdir(parents=True, exist_ok=True)
    out = ctx.records / (rec["recorded"].replace("-", "").replace(":", "") + ".json")   # 20261122T091002Z.json
    out.write_text(json.dumps(rec, indent=2) + "\n")
    for old in sorted(ctx.records.glob("*.json"))[:-KEEP_RECORDS]:
        old.unlink()
    return out


def cmd_record(ctx: Ctx, a):
    rec = make_record(ctx, a)
    out = write_record(ctx, rec)
    print(f"{rec['modules_compiled']:,} / {N_MODULES:,} modules, busy {rec['busy_seconds'] / 3600:.1f} h"
          f"{', WHOLE PROOF' if rec['whole_proof'] else ''}\n{out}")
    return 0


def cmd_finish(ctx: Ctx, a):
    """Done with this computer: stop the build if it runs, write a final record, submit it (the bot then merges)."""
    if supervisor(ctx):
        print("stopping the build first")
        cmd_stop(ctx, a)
    rec = make_record(ctx, a, final=True)
    out = write_record(ctx, rec)
    print(f"final record: {rec['modules_compiled']:,} / {N_MODULES:,} modules\n{out}")
    if not a.repo:
        print("submit it with: riemann-at-home submit --repo DIR")
        return 0
    a.record = str(out)
    return cmd_submit(ctx, a)


# ---------------------------------------------------------------- submit

def validate_record(rec: dict):
    errs = []
    extra = [k for k in rec if k not in RECORD_KEYS]           # a set of keys: order does not matter
    if (not set(RECORD_KEYS) <= set(rec) or any(k not in OPTIONAL_KEYS for k in extra)
            or sum(k in rec for k in NAME_KEYS) > 1):
        errs.append(f"keys {sorted(rec)} != {RECORD_KEYS} (+ optional {LEVEL_KEYS}, at most one of {NAME_KEYS})")
    if "display_name" in rec and name_problem(rec["display_name"]):
        errs.append(f"display_name: {name_problem(rec['display_name'])}")
    if "anonymous" in rec and rec["anonymous"] is not True:
        errs.append("anonymous must be true when present")
    for k, v in (("format", FORMAT), ("archive_sha256", ARCHIVE_SHA256), ("toolchain", TOOLCHAIN),
                 ("mathlib_rev", MATHLIB_REV)):
        if rec.get(k) != v:
            errs.append(f"{k} is {rec.get(k)!r}, expected {v!r}")
    if not re.fullmatch(r"[0-9a-f]{16}", str(rec.get("build_id"))):
        errs.append("build_id must be 16 lowercase hex chars")
    if rec.get("build_folder") not in FIXED_FOLDERS.values():
        errs.append(f"build_folder {rec.get('build_folder')!r} is not a fixed folder")
    if rec.get("tool") != TOOL:
        errs.append(f"tool is {rec.get('tool')!r}, expected {TOOL!r}")
    m = rec.get("machine")
    if not (isinstance(m, dict) and set(m) == {"os", "arch", "cpu", "cores"}
            and all(isinstance(m[k], str) for k in ("os", "arch", "cpu")) and type(m["cores"]) is int):
        errs.append("machine must be {os, arch, cpu: strings, cores: int}")
    st, rc = parse_time(str(rec.get("started"))), parse_time(str(rec.get("recorded")))
    if st is None or rc is None or not st < rc <= time.time() + 300:
        errs.append("need started < recorded <= now")
    elif not (isinstance(rec.get("busy_seconds"), int) and 0 <= rec["busy_seconds"] <= rc - st):
        errs.append("busy_seconds must be an int between 0 and recorded - started")
    if not re.fullmatch(r"[0-9a-f]{64}", str(rec.get("olean_digest"))):
        errs.append("olean_digest must be lowercase hex sha256")
    if len(json.dumps(rec, indent=2)) > 256 * 1024:
        errs.append("record over 256 KB")
    try:
        bits = decode_bitmap(rec["bitmap_b64"], N_MODULES)   # exact length: no bits past module N-1
        raw = gzip.decompress(base64.b64decode(rec["bitmap_b64"]))
        if N_MODULES % 8 and raw[-1] >> (N_MODULES % 8):
            errs.append("bitmap has bits past module N-1")
        if sum(bits) != rec.get("modules_compiled"):
            errs.append("modules_compiled != popcount(bitmap)")
        if not sum(bits):
            errs.append("bitmap is empty")
    except (ValueError, KeyError, OSError, TypeError) as e:
        errs.append(f"bitmap: {e}")
    if not isinstance(rec.get("final"), bool):
        errs.append("final must be true or false")
    if rec.get("whole_proof") is not (rec.get("axioms") is not None):
        errs.append("whole_proof must be true exactly when axioms is a list")
    errs += validate_levels(rec)
    return errs


def validate_levels(rec: dict) -> list:
    """The optional Level 2-3 fields (CONTRACT: "Levels and the joint statement")."""
    errs = []
    has_export = "export_sha256" in rec or "export_bytes" in rec
    if has_export:
        if not ("export_sha256" in rec and "export_bytes" in rec):
            errs.append("export_sha256 and export_bytes go together")
        if not (rec.get("whole_proof") is True and isinstance(rec.get("axioms"), list)
                and sorted(rec["axioms"]) == sorted(EXPECTED_AXIOMS)):
            errs.append("export fields need a whole proof with the three standard axioms")
        if rec.get("export_sha256") != EXPORT_SHA256:
            errs.append("export does not reproduce the reference")
        if not (type(rec.get("export_bytes")) is int and rec["export_bytes"] >= 0):
            errs.append("export_bytes must be a non-negative integer")
    if "checkers" in rec:
        c = rec["checkers"]
        if not has_export:
            errs.append("checkers need export_sha256 (Level 2) first")
        if not (isinstance(c, list) and c and all(
                isinstance(e, dict) and set(e) == {"name", "version", "result", "seconds"}
                and isinstance(e["name"], str) and isinstance(e["version"], str) and 1 <= len(e["name"]) <= 32
                and len(e["version"]) <= 64 and e["result"] in ("accept", "reject")
                and type(e["seconds"]) is int and e["seconds"] >= 0 for e in c)):
            errs.append('checkers must be a non-empty list of {"name", "version", "result": accept|reject, "seconds": int}')
        elif len({e["name"] for e in c}) != len(c):
            errs.append("checkers: one entry per checker")
    if "sign_statement" in rec:
        if rec["sign_statement"] is not True:
            errs.append("sign_statement must be true when present")
        if record_level(rec) < 2:
            errs.append("sign_statement needs Level 2 (whole proof and the reference export)")
    return errs


def record_level(rec: dict) -> int:
    """1 = build; 2 = whole proof + export reproduces the reference; 3 = 2 + an independent checker accepted."""
    if not (rec.get("whole_proof") is True and rec.get("export_sha256") == EXPORT_SHA256):
        return 1
    ok = isinstance(rec.get("checkers"), list) and any(isinstance(e, dict) and e.get("result") == "accept"
                                                       for e in rec["checkers"])
    return 3 if ok else 2


def name_problem(name):
    """None if `name` is a valid display name: plain text, 1-32 characters, no control characters."""
    if not isinstance(name, str) or not 1 <= len(name) <= 32:
        return "must be 1 to 32 characters"
    if any(unicodedata.category(c) in ("Cc", "Cf", "Zl", "Zp") for c in name):
        return "no control characters"
    if name.casefold().startswith("anonymous"):
        return "may not start with \"anonymous\" (use `name --anonymous` for that)"
    if name != name.strip():
        return "no spaces at the start or end"
    return None


