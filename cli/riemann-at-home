    if elan:
        return elan
    print("installing elan (the Lean version manager) from github.com/leanprover/elan")
    init = Path(os.environ.get("TMPDIR", "/tmp")) / f"elan-init-{os.getpid()}.sh"
    req = urllib.request.Request("https://raw.githubusercontent.com/leanprover/elan/master/elan-init.sh",
                                 headers={"User-Agent": USER_AGENT})
    with urllib.request.urlopen(req, timeout=120) as r:
        init.write_bytes(r.read())
    try:
        if run(["sh", str(init), "-y", "--default-toolchain", "none"]).returncode != 0:
            raise Fail("elan install failed")
    finally:
        init.unlink(missing_ok=True)
    elan = which("elan")
    if not elan:
        raise Fail("elan installed but not found in ~/.elan/bin")
    return elan


def toolchain_installed(elan: str, toolchain: str = TOOLCHAIN) -> bool:
    out = subprocess.run([elan, "toolchain", "list"], capture_output=True, text=True, env=lean_env()).stdout
    return any(l.split()[0] == toolchain for l in out.splitlines() if l.strip())


def mathlib_cache_present(folder: Path) -> bool:
    return (folder / ".lake/packages/mathlib/.lake/build/lib/lean/Mathlib.olean").exists()


def cmd_setup(ctx: Ctx, a):
    disk_heads_up(ctx)
    folder = ctx.folder
    if folder.exists():
        tc = toolchain_of(folder)
        if tc != TOOLCHAIN:
            raise Fail(f"{folder} exists but pins {tc or 'no toolchain'}, expected {TOOLCHAIN}. "
                       "Move it aside and run setup again.")
        if mathlib_rev_of(folder) != MATHLIB_REV:
            raise Fail(f"{folder} pins Mathlib {mathlib_rev_of(folder)}, expected {MATHLIB_REV}")
        print(f"[1/3] proof folder already here with {TOOLCHAIN}: {folder} (skipping download)")
    else:
        if a.archive:
            archive = Path(a.archive).expanduser()
            print(f"[1/3] checking {archive}")
            if sha256_file(archive) != ARCHIVE_SHA256:
                raise Fail(f"{archive} does not have sha256 {ARCHIVE_SHA256}")
        else:
            print(f"[1/3] downloading the official archive ({PARTS} parts, {ARCHIVE_BYTES / 1e6:.0f} MB)")
            archive = download_archive(ctx, a.parts_url)
        print(f"      sha256 {ARCHIVE_SHA256} ok; unpacking into {folder}")
        unpack(archive, folder)
        if toolchain_of(folder) != TOOLCHAIN:
            raise Fail(f"unpacked archive pins {toolchain_of(folder)}, expected {TOOLCHAIN}")
    elan = ensure_elan()
    if toolchain_installed(elan):
        print(f"[2/3] Lean {TOOLCHAIN} already installed")
    else:
        print(f"[2/3] installing Lean {TOOLCHAIN}")
        if run([elan, "toolchain", "install", TOOLCHAIN], env=lean_env()).returncode != 0:
            raise Fail("toolchain install failed")
    if mathlib_cache_present(folder) and not a.force_cache:
        print("[3/3] Mathlib compiled cache already here")
    elif a.skip_cache:
        print("[3/3] skipping Mathlib cache (--skip-cache)")
    else:
        print("[3/3] fetching Mathlib's compiled cache (lake exe cache get Mathlib)")
        if run([which("lake") or "lake", "exe", "cache", "get", "Mathlib"], cwd=folder, env=lean_env()).returncode != 0:
            raise Fail("`lake exe cache get Mathlib` failed; run setup again to retry")
    print(f"this computer's build_id: {ctx.build_id()}")
    ask_consent(ctx)
    print(f"ready. Next: riemann-at-home build")


# ---------------------------------------------------------------- build control

def sweep_setup_files(ctx: "Ctx") -> tuple:
    """Delete Lake's per-module scratch files (.lake/build/ir/<Module>.setup.json, ~6 MB each) once their module is
    done. Lake writes one just before compiling a module, hands it to Lean, and never reads it again: whether a module
    is up to date is decided from its .trace, not this file (Lake 4.33.1, Build/Module.lean + Build/Actions.lean).
    A module counts as done when its .trace is newer than its scratch file (the .trace is written last). Without this
    sweep a whole build needs about 1.2 TB; with it about 160 GB. Returns (files deleted, bytes freed)."""
    ir, lib, n, freed = ctx.folder / ".lake/build/ir", ctx.lib, 0, 0
    if not ir.is_dir():
        return 0, 0
    for root, _, files in os.walk(ir):
        rel = os.path.relpath(root, ir)
        for f in files:
            if not f.endswith(".setup.json"):
                continue
            stem, sp = f[:-len(".setup.json")], os.path.join(root, f)
            tp = lib / ("" if rel == "." else rel) / (stem + ".trace")
            try:
                st = os.stat(sp)
                if os.stat(tp).st_mtime >= st.st_mtime:
                    os.unlink(sp); n += 1; freed += st.st_size
            except OSError:
                continue                       # not built yet (no .trace), or already gone
    return n, freed


def setup_sweeper(ctx: "Ctx", stop: "threading.Event", every: float = 60):
    """Background thread: sweep_setup_files every minute until `stop` is set."""
    def loop():
        while True:
            try:
                sweep_setup_files(ctx)
            except Exception:
                pass
            if stop.wait(every):
                return
    threading.Thread(target=loop, daemon=True).start()


# ---------- updates: check daily, tell the volunteer, update only when they say so ----------
UPDATE_URL = os.environ.get("RAH_UPDATE_URL") or f"https://github.com/{UPSTREAM}.git"   # override for tests
UPDATE_EVERY = 24 * 3600


def tool_checkout():
    """The git checkout this tool runs from, or None (e.g. a downloaded copy)."""
    here = Path(__file__).resolve().parent
    r = subprocess.run(["git", "-C", str(here), "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    return Path(r.stdout.strip()) if r.returncode == 0 and r.stdout.strip() else None


def check_update(ctx: "Ctx") -> dict:
    """Ask GitHub whether the tool (cli/) changed on main. One anonymous `git fetch`; no login, no token, nothing sent
    about this computer. Leaderboard data commits by the bot don't count, only changes under cli/.
    Result is saved to update.json: {"checked", "available", "changes": [one line per commit], "error"}."""
    res = {"checked": iso(time.time()), "available": False, "changes": []}
    top = tool_checkout()
    if not top:
        res["error"] = "not a git checkout; update by downloading the repository again"
    else:
        f = subprocess.run(["git", "-C", str(top), "fetch", "--quiet", UPDATE_URL, "main"], capture_output=True,
                           text=True, timeout=120)
        if f.returncode != 0:
            res["error"] = (f.stderr or "git fetch failed").strip()[:300]
        else:
            log = subprocess.run(["git", "-C", str(top), "log", "--format=%s", "HEAD..FETCH_HEAD", "--", "cli/"],
                                 capture_output=True, text=True).stdout.strip()
            res["changes"] = [l for l in log.splitlines() if l][:20]
            res["available"] = bool(res["changes"])
    try:
        ctx.home.mkdir(parents=True, exist_ok=True)
        (ctx.home / "update.json").write_text(json.dumps(res, indent=1) + "\n")
    except OSError:
        pass
    return res


def update_state(ctx: "Ctx") -> dict:
    try:
        return json.loads((ctx.home / "update.json").read_text())
    except (OSError, ValueError):
        return {}


def update_checker(ctx: "Ctx", stop: "threading.Event"):
    """Background thread: check for a new version now (if the last check is over a day old) and then daily."""
    def loop():
        while True:
            last = update_state(ctx).get("checked")
            age = time.time() - datetime.fromisoformat(last.replace("Z", "+00:00")).timestamp() if last else 1e12
            if age >= UPDATE_EVERY:
                try:
                    r = check_update(ctx)
                    if r.get("available"):
                        print(f"update available ({len(r['changes'])} change(s)): run `riemann-at-home update`",
                              flush=True)
                except Exception:
                    pass
                age = 0
            if stop.wait(max(60, UPDATE_EVERY - age)):
                return
    threading.Thread(target=loop, daemon=True).start()


def cmd_update(ctx: Ctx, a):
    top = tool_checkout()
    if not top:
        raise Fail("this copy isn't a git checkout; download the repository again to update")
    r = check_update(ctx)
    if r.get("error"):
        raise Fail(f"couldn't check for updates: {r['error']}")
    if not r["available"]:
        print("already up to date")
        return 0
    print("What changes:")
    for c in r["changes"]:
        print(f"  - {c}")
    dirty = subprocess.run(["git", "-C", str(top), "status", "--porcelain", "--", "cli/"], capture_output=True,
                           text=True).stdout.strip()
    if dirty:
        raise Fail("you have local edits in cli/; keep them or undo them before updating:\n" + dirty)
    if not a.yes:
        if not sys.stdin.isatty():
            raise Fail("run `riemann-at-home update --yes` to apply it")
        if input("Update now? Building continues where it left off. [y/N] ").strip().lower() not in ("y", "yes"):
            print("not updated")
            return 0
    m = subprocess.run(["git", "-C", str(top), "merge", "--ff-only", "--quiet", "FETCH_HEAD"], capture_output=True,
                       text=True)
    if m.returncode != 0:
        raise Fail("couldn't update (your copy has its own commits?): " + (m.stderr or m.stdout).strip()[:300])
    (ctx.home / "update.json").write_text(json.dumps({"checked": iso(time.time()), "available": False,
                                                      "changes": []}) + "\n")
    me = [sys.executable, "-I", str(Path(__file__).resolve())]
    if supervisor(ctx):                           # restart the build with the new code; Lean picks up where it was
        mode, paused = stored_mode(ctx), is_paused(ctx)
        subprocess.run(me + ["stop", "--folder", str(ctx.folder)], check=False)
        subprocess.run(me + ["build", f"--{mode}", "--folder", str(ctx.folder)], check=False)
        if paused:
            subprocess.run(me + ["pause", "--folder", str(ctx.folder)], check=False)
    page = ctx.logs / "page.pid"                  # this computer's local page (written by `page`): restart it
    try:
        pid, port = (int(x) for x in page.read_text().split())
    except (OSError, ValueError):
        pid = port = None
    if pid and pid_alive(pid, "riemann-at-home"):
        os.kill(pid, signal.SIGTERM)
        for _ in range(20):
            if not pid_alive(pid):
                break
            time.sleep(0.25)
        subprocess.Popen(me + ["page", "--folder", str(ctx.folder), "--port", str(port)], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        print("local page restarted")
    print("updated")
    return 0


def cmd_sweep(ctx: Ctx, a):
    n, freed = sweep_setup_files(ctx)
    print(f"deleted {n:,} finished modules' scratch files, freed {freed / 1e9:.1f} GB")


def free_gb(folder: Path) -> float:
    p = folder
    while not p.exists():
        p = p.parent
    return shutil.disk_usage(p).free / 1e9


def disk_message(ctx: Ctx) -> str:
    return (f"only {free_gb(ctx.folder):.1f} GB free on the build disk, so the build stopped to leave "
            f"{MIN_FREE_GB:g} GB for the rest of your computer (a whole build needs about {WHOLE_BUILD_GB} GB). "
            "Free some space, then `riemann-at-home build` continues from here. "
            "`record` and `submit` still work for what is built.")


def disk_heads_up(ctx: Ctx) -> None:
    """Said before setup and every build: what the whole thing takes, and what this computer can do."""
    folder = ctx.folder if ctx.folder.exists() else ctx.folder.parent
    while not folder.exists() and folder != folder.parent:
        folder = folder.parent
    free = shutil.disk_usage(folder).free / 1e9
    print(f"Heads up: building the whole proof takes about 2 days on a fast computer (a week or more on a laptop) and "
          f"needs roughly {WHOLE_BUILD_GB} GB of free disk (estimated from builds so far). This computer has {free:.0f} GB free.")
    if free < WHOLE_BUILD_GB:
        print(f"That's not enough for the whole proof, and that's fine: the build stops by itself when "
              f"{MIN_FREE_GB:g} GB are left, so your computer always keeps room, and every module you built still "
              "counts on the leaderboard.")
    print("Pause any time with `riemann-at-home pause`; `riemann-at-home stop` keeps everything built so far.\n")


def stored_mode(ctx: Ctx) -> str:
    m = read(ctx.mode_file).strip()
    return m if m in ("gentle", "full") else "gentle"


def cmd_build(ctx: Ctx, a):
    mode = "full" if a.full else "gentle" if a.gentle else stored_mode(ctx)
    ctx.logs.mkdir(parents=True, exist_ok=True)
    if getattr(a, "submit", False):           # auto-submit on; a running build picks it up on its next cycle
        need_consent(ctx)
        check_gh(True)
        sc = ctx.conf().get("submit") or {}
        ctx.set_conf(submit={**sc, "auto": True, "upstream": sc.get("upstream") or UPSTREAM})
        print(f"auto-submit on: this build's pull request on {ctx.conf()['submit']['upstream']} is updated about every 10 min")
    sup = supervisor(ctx)
    if sup:
        if mode != stored_mode(ctx) or a.full or a.gentle:
            ctx.mode_file.write_text(mode)
            set_priority(build_pids(ctx), mode)
            log_event(ctx, f"MODE_{mode.upper()}")
            print(f"build already running (pid {sup}); speed set to {mode}")
        else:
            print(f"build already running (pid {sup}), {mode}")
        return 0
    other = outside_build(ctx)
    if other:
        raise Fail(f"another build is already running in {ctx.folder} (lake pid {', '.join(map(str, other))}), "
                   "not started by this tool. Stop that one first.")
    if toolchain_of(ctx.folder) != TOOLCHAIN:
        raise Fail(f"{ctx.folder} is not set up (expected lean-toolchain {TOOLCHAIN}); run: riemann-at-home setup")
    if not which("lake"):
        raise Fail("lake not found; run: riemann-at-home setup")
    if free_gb(ctx.folder) < MIN_FREE_GB:
        raise Fail(disk_message(ctx))
    disk_heads_up(ctx)
    if a.submit_repo:                         # older, dry-run-only setting
        ctx.set_conf(repo=str(Path(a.submit_repo).expanduser().resolve()))
    ctx.mode_file.write_text(mode)
    cmd = [sys.executable, "-I", str(Path(__file__).resolve()), "_run", "--folder", str(ctx.folder),
           "--logs", str(ctx.logs), "--target", a.target] + (["--test-unofficial-folder"] if a.test_unofficial_folder else [])
    with open(ctx.logs / "supervisor.log", "ab") as lf:
        p = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=lf, stderr=lf, start_new_session=True,
                             env={**os.environ, "RAH_HOME": str(ctx.home)})
    for _ in range(100):
        if read_pid(ctx.pgid_file) and supervisor(ctx) == p.pid:
            break
        if p.poll() is not None:
            raise Fail(f"build failed to start; see {ctx.logs / 'supervisor.log'}")
        time.sleep(0.1)
    print(f"building `lake build {a.target}` in {ctx.folder} ({mode}), in the background.\n"
          f"  log: {ctx.logs / 'build.log'}\n  riemann-at-home status | pause | resume | stop")
    return 0


def cmd_run(ctx: Ctx, a):
    """The background supervisor: runs the official `lake build Main` unchanged (nice 19), then the axiom check."""
    ctx.logs.mkdir(parents=True, exist_ok=True)
    ctx.pid_file.write_text(str(os.getpid()))
    log_event(ctx, "RESTART" if any(k == "START" for k, _, _ in events(ctx)) else "START")
    if free_gb(ctx.folder) < MIN_FREE_GB:
        print(disk_message(ctx), flush=True)
        log_event(ctx, "DISK_LOW")
        log_event(ctx, "BUILD_EXIT=disk")
        ctx.pid_file.unlink(missing_ok=True)
        return 1
    mode = stored_mode(ctx)
    tcmd = (["/usr/bin/time", "-l"] if IS_MAC else ["/usr/bin/time", "-v"]) if Path("/usr/bin/time").exists() else []
    cmd = tcmd + ["nice", "-n", "19", which("lake") or "lake", "--no-ansi", "build", a.target]
    stopping, terminated, disk_low = threading.Event(), threading.Event(), threading.Event()
    with open(ctx.logs / "build.log", "ab") as out, open(ctx.logs / "time.txt", "ab") as err:
        p = subprocess.Popen(cmd, cwd=ctx.folder, stdin=subprocess.DEVNULL, stdout=out, stderr=err,
                             env=lean_env(), start_new_session=True)
    ctx.pgid_file.write_text(str(p.pid))
    start_caffeinate(ctx, p.pid)

    def on_term(sig, frm):
        terminated.set()
        for s in (signal.SIGCONT, signal.SIGTERM):
            try:
                os.killpg(p.pid, s)
            except OSError:
                pass
    signal.signal(signal.SIGTERM, on_term)
    signal.signal(signal.SIGINT, on_term)

    def sampler():                            # first sample now: the baseline for this session's speed
        while True:
            with open(ctx.samples, "a") as f:
                f.write(f"{iso(time.time())} modules={count_compiled(ctx.lib)}\n")
            if stopping.wait(SAMPLE_SECONDS):
                return
    threading.Thread(target=sampler, daemon=True).start()

    def disk_guard():                         # stop safely before the disk fills; everything built is kept
        while not stopping.wait(DISK_CHECK_SECONDS):
            if free_gb(ctx.folder) < MIN_FREE_GB:
                print(disk_message(ctx), flush=True)
                log_event(ctx, "DISK_LOW")
                disk_low.set()
                on_term(None, None)
                return
    threading.Thread(target=disk_guard, daemon=True).start()
    setup_sweeper(ctx, stopping)              # keeps a whole build near 160 GB instead of 1.2 TB
    update_checker(ctx, stopping)             # daily: is there a newer version? (tells, never installs)

    (ctx.logs / "supervisor.features").write_text(f"{os.getpid()} autosubmit-v2\n")   # rereads interval/config

    def progress():                           # refresh the record on this build's one PR (interval reread each cycle)
        while not stopping.wait(autosubmit_interval(ctx)):
            autosubmit(ctx, a, "progress")
    threading.Thread(target=progress, daemon=True).start()
    if mode == "gentle":                      # new lean processes inherit lake's policy
        for _ in range(30):
            pids = build_pids(ctx)
            if pids:
                set_priority(pids, mode)
                break
            time.sleep(1)
    rc = p.wait()
    stopping.set()
    stop_caffeinate(ctx)
    log_event(ctx, f"BUILD_EXIT={rc}")
    final_submit = rc == 0 or disk_low.is_set()
    if rc == 0 and a.target == "Main" and not terminated.is_set():
        audit = ctx.home / "audit"
        audit.mkdir(parents=True, exist_ok=True)
        (audit / "Audit.lean").write_text(AUDIT_LEAN)
        with open(ctx.logs / "axioms.log", "wb") as f:
            r = subprocess.run([which("lake") or "lake", "--no-ansi", "env", "lean", f"--root={audit}",
                                str(audit / "Audit.lean")], cwd=ctx.folder, stdout=f, stderr=subprocess.STDOUT,
                               env=lean_env())
        log_event(ctx, f"AXIOMS_EXIT={r.returncode}")
    if final_submit:
        autosubmit(ctx, a, "final")
    ctx.pgid_file.unlink(missing_ok=True)
    ctx.pid_file.unlink(missing_ok=True)
    return rc


def autosubmit(ctx: Ctx, a, why: str):
    """Write a record and, if auto-submit is on, update this build's one PR: runs `_autosubmit` from the script on
    disk, which rereads config.json each time. Output goes to logs/autosubmit.log. Never raises."""
    if AUTOSUBMIT == "off":
        return
    me = [sys.executable, "-I", str(Path(__file__).resolve())]
    loc = ["--folder", str(ctx.folder), "--logs", str(ctx.logs)]
    with open(ctx.logs / "autosubmit.log", "a") as f:
        f.write(f"--- autosubmit ({why}) {iso(time.time())}\n")
        f.flush()
        try:
            extra = ["--test-unofficial-folder"] if getattr(a, "test_unofficial_folder", False) else []
            subprocess.run(me + ["_autosubmit"] + loc + extra, stdout=f, stderr=subprocess.STDOUT,
                           env={**os.environ, "RAH_HOME": str(ctx.home)}, timeout=6 * 3600)
        except Exception as e:
            f.write(f"autosubmit failed: {e}\n")


def need_running(ctx: Ctx) -> int:
    if not supervisor(ctx) or not read_pid(ctx.pgid_file):
        raise Fail("no build is running. Start one with: riemann-at-home build")
    return read_pid(ctx.pgid_file)


def cmd_pause(ctx: Ctx, a):
    pgid = need_running(ctx)
    if is_paused(ctx):
        print("already paused")
        return 0
    os.killpg(pgid, signal.SIGSTOP)
    stop_caffeinate(ctx)
    log_event(ctx, "PAUSE")
    print("paused: frozen in place, nothing is lost. riemann-at-home resume")
    return 0


def cmd_resume(ctx: Ctx, a):
    if not supervisor(ctx):
        print("no build running; starting it again (it picks up where it stopped)")
        a.gentle = a.full = False
        return cmd_build(ctx, a)
    pgid = need_running(ctx)
    os.killpg(pgid, signal.SIGCONT)
    if is_paused(ctx):
        start_caffeinate(ctx, pgid)
        log_event(ctx, "RESUME")
    print(f"resumed ({stored_mode(ctx)})")
    return 0


def cmd_stop(ctx: Ctx, a):
    sup = supervisor(ctx)
    if not sup:
        print("no build running")
        return 0
    if is_paused(ctx):
        log_event(ctx, "RESUME")
    log_event(ctx, "STOP_REQUESTED")
    os.kill(sup, signal.SIGTERM)
    for _ in range(300):
        if not pid_alive(sup):
            break
        time.sleep(0.1)
    else:
        pgid = read_pid(ctx.pgid_file)
        if pgid:
            try:
                os.killpg(pgid, signal.SIGKILL)
            except OSError:
                pass
    print("stopped. Everything compiled so far is kept; `riemann-at-home build` continues from here.")
    return 0


# ---------------------------------------------------------------- status

SPEED_WINDOW = 1800   # speed = modules finished in the last 30 minutes of samples


def session_samples(ctx: Ctx) -> list:
    """Samples grouped by build session (each START/RESTART opens one). Counts are totals in the folder, so
    only differences within a session measure work done; modules that were already there never count."""
    starts = sorted(t for k, _, t in events(ctx) if k in ("START", "RESTART"))
    groups = [[] for _ in range(len(starts) + 1)]
    for t, n in samples(ctx):
        i = sum(1 for st in starts if st <= t)
        groups[i].append((t, n))
    return [g for g in groups if g]


def rate_per_hour(ctx: Ctx):
    """Modules per hour over the current session's last SPEED_WINDOW seconds; None until measurable."""
    ss = session_samples(ctx)
    if not ss:
        return None
    cur = ss[-1]
    recent = [x for x in cur if x[0] >= cur[-1][0] - SPEED_WINDOW]
    if len(recent) < 2:
        recent = cur[-2:]
    if len(recent) < 2:
        return None
    (t0, n0), (t1, n1) = recent[0], recent[-1]
    if t1 - t0 < 60:
        return None
    return max(0, n1 - n0) / (t1 - t0) * 3600


def built_by_this_tool(ctx: Ctx) -> int:
    """Modules finished while builds were measured (sum over sessions of last minus first sample)."""
    return sum(max(0, g[-1][1] - g[0][1]) for g in session_samples(ctx))


def cmd_status(ctx: Ctx, a):
    done = count_compiled(ctx.lib) if ctx.lib.exists() else 0
    sup = supervisor(ctx)
    ev = events(ctx)
    print(f"folder    {ctx.folder}{'' if ctx.folder.exists() else '  (not set up: riemann-at-home setup)'}")
    print(f"compiled  {done:,} / {N_MODULES:,} modules ({100 * done / N_MODULES:.2f}%)")
    if sup:
        state = "PAUSED" if is_paused(ctx) else f"running, {stored_mode(ctx)}"
        active = len(build_pids(ctx, ("lean",)))
        print(f"build     {state} (pid {sup}, {active} modules compiling now)")
    elif outside_build(ctx):
        print(f"build     running, started outside this tool (lake pid {', '.join(map(str, outside_build(ctx)))}); "
              "pause/stop only control builds started with `riemann-at-home build`")
    else:
        last = next((raw for k, raw, _ in reversed(ev) if k == "BUILD_EXIT"), None)
        how = {"BUILD_EXIT=0": "finished"}.get(last, "stopped" + (f" ({last})" if last else ""))
        print(f"build     not running, {how}" if ev else "build     not started yet")
    started, busy = busy_seconds(ctx, bool(sup) or bool(outside_build(ctx)))
    if started:
        print(f"started   {iso(started)}, busy {busy / 3600:.1f} h")
    r = rate_per_hour(ctx)
    built = built_by_this_tool(ctx)
    if sup and is_paused(ctx):
        print("speed     paused")
    elif sup and r is None:
        print(f"speed     measuring (first reading about {SAMPLE_SECONDS / 60:.0f} min after the build started)")
    elif sup and r is not None:
        left = N_MODULES - done
        eta = f", about {left / r / 24:.1f} days to go at this speed" if r > 0 else ""
        print(f"speed     {r:,.0f} modules/hour over the last {SPEED_WINDOW // 60} min{eta}")
    elif built and busy >= 600:
        print(f"speed     {built / busy * 3600:,.0f} modules/hour on average ({built:,} built while measured)")
    up = update_state(ctx)
    if up.get("available"):
        print(f"update    available ({len(up['changes'])} change(s)): riemann-at-home update")
    ax = read(ctx.logs / "axioms.log")
    if ax:
        print(f"axioms    {parse_axioms(ax)}")
    ex = levels_state(ctx).get("export")
    if ex and ex.get("sha256") == EXPORT_SHA256:
        lv = levels_state(ctx)
        ok = [e["name"] for e in lv.get("checkers", []) if e.get("result") == "accept"]
        print(f"level     {3 if ok else 2}: export reproduces the reference" + (f", re-checked by {', '.join(ok)}" if ok else "")
              + (", joint statement signed" if lv.get("sign_statement") else ""))
    elif ex:
        print(f"export    sha256 {ex.get('sha256')} does not match the reference ({UNVERIFIED})")
    elif done == N_MODULES and parse_axioms(ax) is not None:
        print("level     1: whole proof built. Next: riemann-at-home export")
    return 0


# ---------------------------------------------------------------- record

def make_record(ctx: Ctx, a, final: bool = False) -> dict:
    folder = ctx.folder
    official = str(folder) == str(fixed_folder())
    if not official and not a.test_unofficial_folder:
        raise Fail(f"records come from the fixed folder {fixed_folder()} only (got {folder})")
    if toolchain_of(folder) != TOOLCHAIN:
        raise Fail(f"{folder} pins {toolchain_of(folder) or 'no toolchain'}, expected {TOOLCHAIN}")
    if mathlib_rev_of(folder) != MATHLIB_REV:
        raise Fail(f"{folder} pins Mathlib {mathlib_rev_of(folder)}, expected {MATHLIB_REV}")
    mods = all_modules(folder)
    if len(mods) != N_MODULES and not a.test_unofficial_folder:
        raise Fail(f"{folder}/src has {len(mods):,} modules, expected {N_MODULES:,}: not the official archive")
    done = compiled_modules(ctx.lib)
    bits = [m in done for m in mods]
    cache = HashCache(ctx.home / "olean-hashes.json")
    digest = olean_digest(ctx.lib, mods, bits, cache)
    cache.save()
    started, busy = busy_seconds(ctx, bool(supervisor(ctx)) or bool(outside_build(ctx)))
    n = sum(bits)
    if n == 0:
        raise Fail("nothing compiled yet, so there is nothing to record. Start with: riemann-at-home build")
    recorded = int(time.time())
    # Modules may predate this tool's logs (a folder built before, or by another script). `started` is the earlier
    # of the first logged start and the first finished module, so new-modules / (recorded - started) stays an
    # honest rate for the bot's speed check, even on a first record of a pre-built folder.
    first_trace = min((ctx.lib / (m.replace(".", "/") + ".trace")).stat().st_mtime for m, on in zip(mods, bits) if on)
    started = int(min(started if started is not None else first_trace, first_trace, recorded - 1))
    bid = ctx.build_id()
    kept = ctx.conf().get("started") or {}      # keep `started` steady across this build's records
    if kept.get("build_id") == bid and isinstance(kept.get("t"), int) and kept["t"] <= started:
        started = kept["t"]
    else:
        ctx.set_conf(started={"build_id": bid, "t": started})
    busy = max(0, min(busy, recorded - started))
    axioms = None
    if n == len(mods) and mods:
        axioms = parse_axioms(read(ctx.logs / "axioms.log"))
    rec = {
        "format": FORMAT,
        "tool": TOOL,
        "archive_sha256": ARCHIVE_SHA256,
        "toolchain": TOOLCHAIN,
        "mathlib_rev": MATHLIB_REV,
        "build_folder": str(folder) if official else "unofficial",
        "build_id": bid,
        "machine": machine(),
        "started": iso(started),
        "recorded": iso(recorded),
        "busy_seconds": busy,
        "modules_compiled": n,
        "bitmap_b64": encode_bitmap(bits),
        "olean_digest": digest,
        "whole_proof": axioms is not None,
        "axioms": axioms,
        "final": bool(final),
    }
    assert list(rec) == RECORD_KEYS
    shown = ctx.conf().get("display")
    if isinstance(shown, dict) and name_problem(shown.get("display_name")) is None:
        rec["display_name"] = shown["display_name"]
    rec.update(level_fields(ctx, rec))
    if official:
        errs = validate_record(rec)
        if errs:
            raise Fail("record failed its own check:\n  " + "\n  ".join(errs))
    return rec


KEEP_RECORDS = 50


def write_record(ctx: Ctx, rec: dict) -> Path:
    """records/<UTC time>.json locally (history; the repo keeps one file per build). Keeps the last 50."""
    ctx.records.mkdir(parents=True, exist_ok=True)
    out = ctx.records / (rec["recorded"].replace("-", "").replace(":", "") + ".json")   # 20261122T091002Z.json
    out.write_text(json.dumps(rec, indent=2) + "\n")
    for old in sorted(ctx.records.glob("*.json"))[:-KEEP_RECORDS]:
        old.unlink()
    return out


def cmd_record(ctx: Ctx, a):
    rec = make_record(ctx, a)
    out = write_record(ctx, rec)
    print(f"{rec['modules_compiled']:,} / {N_MODULES:,} modules, busy {rec['busy_seconds'] / 3600:.1f} h"
          f"{', WHOLE PROOF' if rec['whole_proof'] else ''}\n{out}")
    if called_by_supervisor(ctx) and (ctx.conf().get("submit") or {}).get("auto"):
        cmd_autosubmit(ctx, a)                    # a supervisor started before `_autosubmit` existed
        ensure_companion(ctx)
    return 0


def cmd_finish(ctx: Ctx, a):
    """Done with this computer: stop the build if it runs, write a final record, submit it (the bot then merges)."""
    if supervisor(ctx):
        print("stopping the build first")
        cmd_stop(ctx, a)
    rec = make_record(ctx, a, final=True)
    out = write_record(ctx, rec)
    print(f"final record: {rec['modules_compiled']:,} / {N_MODULES:,} modules\n{out}")
    if not (a.submit or a.dry_run or (ctx.conf().get("submit") or {}).get("auto")):
        print("submit it with: riemann-at-home submit")
        return 0
    a.record, a.enable_auto, a.disable_auto, a.interval = str(out), False, False, None
    return cmd_submit(ctx, a)


# ---------------------------------------------------------------- submit

def validate_record(rec: dict):
    errs = []
    extra = [k for k in rec if k not in RECORD_KEYS]           # a set of keys: order does not matter
    if (not set(RECORD_KEYS) <= set(rec) or any(k not in OPTIONAL_KEYS for k in extra)
            or sum(k in rec for k in NAME_KEYS) > 1):
        errs.append(f"keys {sorted(rec)} != {RECORD_KEYS} (+ optional {LEVEL_KEYS + PROGRESS_KEYS}, at most one of {NAME_KEYS})")
    if "display_name" in rec and name_problem(rec["display_name"]):
        errs.append(f"display_name: {name_problem(rec['display_name'])}")
    if "anonymous" in rec:
        errs.append("anonymous is not offered: the pull request always shows your GitHub username")
    for k, v in (("format", FORMAT), ("archive_sha256", ARCHIVE_SHA256), ("toolchain", TOOLCHAIN),
                 ("mathlib_rev", MATHLIB_REV)):
        if rec.get(k) != v:
            errs.append(f"{k} is {rec.get(k)!r}, expected {v!r}")
    if not re.fullmatch(r"[0-9a-f]{16}", str(rec.get("build_id"))):
        errs.append("build_id must be 16 lowercase hex chars")
    if rec.get("build_folder") not in FIXED_FOLDERS.values():
        errs.append(f"build_folder {rec.get('build_folder')!r} is not a fixed folder")
    if rec.get("tool") != TOOL:
        errs.append(f"tool is {rec.get('tool')!r}, expected {TOOL!r}")
    m = rec.get("machine")
    if not (isinstance(m, dict) and set(m) == {"os", "arch", "cpu", "cores"}
            and all(isinstance(m[k], str) for k in ("os", "arch", "cpu")) and type(m["cores"]) is int):
        errs.append("machine must be {os, arch, cpu: strings, cores: int}")
    st, rc = parse_time(str(rec.get("started"))), parse_time(str(rec.get("recorded")))
    if st is None or rc is None or not st < rc <= time.time() + 300:
        errs.append("need started < recorded <= now")
    elif not (isinstance(rec.get("busy_seconds"), int) and 0 <= rec["busy_seconds"] <= rc - st):
        errs.append("busy_seconds must be an int between 0 and recorded - started")
    if not re.fullmatch(r"[0-9a-f]{64}", str(rec.get("olean_digest"))):
        errs.append("olean_digest must be lowercase hex sha256")
    if len(json.dumps(rec, indent=2)) > 256 * 1024:
        errs.append("record over 256 KB")
    try:
        bits = decode_bitmap(rec["bitmap_b64"], N_MODULES)   # exact length: no bits past module N-1
        raw = gzip.decompress(base64.b64decode(rec["bitmap_b64"]))
        if N_MODULES % 8 and raw[-1] >> (N_MODULES % 8):
            errs.append("bitmap has bits past module N-1")
        if sum(bits) != rec.get("modules_compiled"):
            errs.append("modules_compiled != popcount(bitmap)")
        if not sum(bits):
            errs.append("bitmap is empty")
    except (ValueError, KeyError, OSError, TypeError) as e:
        errs.append(f"bitmap: {e}")
    if not isinstance(rec.get("final"), bool):
        errs.append("final must be true or false")
    if rec.get("whole_proof") is not (rec.get("axioms") is not None):
        errs.append("whole_proof must be true exactly when axioms is a list")
    errs += validate_levels(rec)
    return errs


def validate_levels(rec: dict) -> list:
    """The optional Level 2-3 fields (CONTRACT: "Levels and the joint statement")."""
    errs = []
    has_export = "export_sha256" in rec or "export_bytes" in rec
    if has_export:
        if not ("export_sha256" in rec and "export_bytes" in rec):
            errs.append("export_sha256 and export_bytes go together")
        if not (rec.get("whole_proof") is True and isinstance(rec.get("axioms"), list)
                and sorted(rec["axioms"]) == sorted(EXPECTED_AXIOMS)):
            errs.append("export fields need a whole proof with the three standard axioms")
        if rec.get("export_sha256") != EXPORT_SHA256:
            errs.append("export does not reproduce the reference")
        if not (type(rec.get("export_bytes")) is int and rec["export_bytes"] >= 0):
            errs.append("export_bytes must be a non-negative integer")
    if "checkers" in rec:
        c = rec["checkers"]
        if not has_export:
            errs.append("checkers need export_sha256 (Level 2) first")
        if not (isinstance(c, list) and c and all(
                isinstance(e, dict) and set(e) == {"name", "version", "result", "seconds"}
                and isinstance(e["name"], str) and isinstance(e["version"], str) and 1 <= len(e["name"]) <= 32
                and len(e["version"]) <= 64 and e["result"] in ("accept", "reject")
                and type(e["seconds"]) is int and e["seconds"] >= 0 for e in c)):
            errs.append('checkers must be a non-empty list of {"name", "version", "result": accept|reject, "seconds": int}')
        elif len({e["name"] for e in c}) != len(c):
            errs.append("checkers: one entry per checker")
    if "sign_statement" in rec:
        if rec["sign_statement"] is not True:
            errs.append("sign_statement must be true when present")
        if record_level(rec) < 2:
            errs.append("sign_statement needs Level 2 (whole proof and the reference export)")
    return errs


def record_level(rec: dict) -> int:
    """1 = build; 2 = whole proof + export reproduces the reference; 3 = 2 + an independent checker accepted."""
    if not (rec.get("whole_proof") is True and rec.get("export_sha256") == EXPORT_SHA256):
        return 1
    ok = isinstance(rec.get("checkers"), list) and any(isinstance(e, dict) and e.get("result") == "accept"
                                                       for e in rec["checkers"])
    return 3 if ok else 2


def name_problem(name):
    """None if `name` is a valid display name: plain text, 1-32 characters, no control characters."""
    if not isinstance(name, str) or not 1 <= len(name) <= 32:
        return "must be 1 to 32 characters"
    if any(unicodedata.category(c) in ("Cc", "Cf", "Zl", "Zp") for c in name):
        return "no control characters"
    if name.casefold().startswith("anonymous"):
        return "may not start with \"anonymous\" (nobody is anonymous: your pull request shows your username)"
    if name != name.strip():
        return "no spaces at the start or end"
    return None


def cmd_name(ctx: Ctx, a):
    """What the Riemann@home page shows for you instead of your GitHub login."""
    if a.clear:
        ctx.set_conf(display=None)
        print("cleared: the Riemann@home page shows your GitHub username")
        return 0
    if a.display_name is None:
        d = ctx.conf().get("display")
        print(f"display name: {d['display_name']}" if isinstance(d, dict) and d.get("display_name")
              else "not set: the page shows your GitHub username")
        return 0
    name = a.display_name.strip()
    err = name_problem(name)
    if err:
        raise Fail(f"display name {err}")
    ctx.set_conf(display={"display_name": name})
    print(f"display name: {name}")
    print(NAME_NOTICE)
    return 0


def check_gh(dry_run: bool):
    """gh must be installed and logged in. Logging in is the human's job: this tool never handles tokens."""
    if not shutil.which("gh"):
        how = "brew install gh" if IS_MAC else "see https://cli.github.com"
        if IS_MAC and shutil.which("brew") and sys.stdin.isatty() and not dry_run:
            if input("GitHub's `gh` tool is needed to submit. Install it with Homebrew now? [y/N] ").strip().lower() == "y":
                if run(["brew", "install", "gh"]).returncode == 0 and shutil.which("gh"):
                    return check_gh(dry_run)
        raise Fail(f"GitHub's `gh` tool is not installed. Install it ({how}), then run `gh auth login` yourself.")
    if subprocess.run(["gh", "auth", "status"], capture_output=True, text=True, timeout=GH_TIMEOUT).returncode != 0:
        raise Fail("`gh` is not logged in to GitHub. Please run `gh auth login` yourself, then submit again.")


def gh_login() -> str:
    r = subprocess.run(["gh", "api", "user", "--jq", ".login"], capture_output=True, text=True, timeout=GH_TIMEOUT)
    if r.returncode != 0 or not r.stdout.strip():
        raise Fail("could not get your GitHub login from `gh` (run `gh auth login`, or pass --login)")
    return r.stdout.strip()


def pr_state(ctx: Ctx, repo: Path, upstream: str, rel: str, bid: str, check_github: bool) -> dict:
    """Where this build's one pull request stands: state none | open, and whether the build is done. The bot merges
    a PR only when the record is whole_proof or final, so a merged PR (the file is on main) means nothing more is
    submitted; neither is anything after a final record sent from here. Read-only: local git, the remembered state
    in config.json, and (unless told not to) `gh pr list`."""
    st = ctx.conf().get("pr") or {}
    if st.get("build_id") != bid:
        st = {}
    out = {"state": st.get("state"), "number": st.get("number"), "url": st.get("url"),
           "done": "a final record was already sent from this computer" if st.get("final_sent") else None}
    if check_github:
        r = subprocess.run(["gh", "pr", "list", "--repo", upstream, "--head", f"rah/{bid}", "--state", "all",
                            "--json", "number,url,state"], capture_output=True, text=True, timeout=GH_TIMEOUT)
        try:
            prs = json.loads(r.stdout)
            op = [p for p in prs if p.get("state") == "OPEN"]
            out["state"] = "open" if op else None
            if op:
                out["number"], out["url"] = op[0].get("number"), op[0].get("url")
            if any(p.get("state") == "MERGED" for p in prs):
                out["done"] = "its pull request was merged"
        except (ValueError, TypeError, AttributeError):
            pass
    if (repo / ".git").exists():
        shown = subprocess.run(["git", "-C", str(repo), "show", f"origin/main:{rel}"], capture_output=True, text=True)
        if shown.returncode == 0:
            try:
                d = json.loads(shown.stdout)
                out["done"] = "its final record is merged" if d.get("final") else \
                    "its whole-proof record is merged" if d.get("whole_proof") else "its record is merged"
            except ValueError:
                out["done"] = "its record is merged"
    return out


def git_identity(repo: Path, login: str) -> tuple:
    """(name, email) for commits: the volunteer's git name if set, and an email only in GitHub's noreply form
    (their own noreply address if configured, else <login>@users.noreply.github.com). No other email ever."""
    get = lambda k: subprocess.run(["git", "-C", str(repo), "config", "--get", k], capture_output=True,
                                   text=True).stdout.strip()
    name, email = get("user.name"), get("user.email")
    if not re.fullmatch(r"(?:\d+\+)?[A-Za-z0-9-]+@users\.noreply\.github\.com", email or ""):
        email = f"{login}@users.noreply.github.com"
    return (name or login), email


def comparable(rec: dict) -> dict:
    """A record minus what changes every time (`recorded`, `busy_seconds`): equal means nothing new to push."""
    return {k: v for k, v in rec.items() if k not in ("recorded", "busy_seconds")}




def submit_real(ctx: Ctx, a, src: Path, rec: dict, login: str, upstream: str) -> int:
    """This build's one PR: branch rah/<build_id> = upstream main + one commit that writes
    submissions/<login>/<build_id>.json, force-pushed on every update. Opens the PR the first time."""
    repo = ctx.home / "repo"                     # the tool's own clone; never the volunteer's checkouts
    bid = rec["build_id"]
    rel = f"submissions/{login}/{bid}.json"
    branch = f"rah/{bid}"
    sc = ctx.conf().get("submit") or {}
    if not (repo / ".git").exists():
        repo.parent.mkdir(parents=True, exist_ok=True)
        gh(["repo", "clone", upstream, str(repo), "--", "-q"], "clone the Riemann@home repo")
        ctx.set_conf(submit={**sc, "clone_of": upstream})
    elif sc.get("clone_of", upstream) != upstream:
        raise Fail(f"{repo} is a clone of {sc.get('clone_of')}, not {upstream}; move it aside to switch")
    g = lambda *x, **k: git(repo, *x, **k)
    g("fetch", "-q", "origin", "main")
    pr = pr_state(ctx, repo, upstream, rel, bid, check_github=True)
    if pr["done"]:
        raise Fail(f"build {bid} is finished ({pr['done']}); nothing more is submitted for it. "
                   "A new build on another computer gets its own build_id from `riemann-at-home setup`.")
    last = ctx.conf().get("pr") or {}
    last = last if last.get("build_id") == bid else {}
    if (pr["state"] == "open" and last.get("pushed") == hashlib.sha256(json.dumps(comparable(rec), sort_keys=True)
                                                                         .encode()).hexdigest()
            and time.time() - last.get("pushed_at", 0) < TIMES_ONLY_SECONDS and not rec["final"]):
        print(f"nothing new since the last push ({rec['modules_compiled']:,} modules; only times changed, pushed at "
              f"most every {TIMES_ONLY_SECONDS // 60} min); PR {pr['url']} unchanged")
        return 0
    # push straight to upstream if allowed, else to the volunteer's fork
    perm = gh(["api", f"repos/{upstream}", "--jq", ".permissions.push"], "check push access").strip()
    if perm == "true":
        remote, owner = "origin", upstream.split("/")[0]
    else:
        if git(repo, "remote", "get-url", "fork", check=False).returncode != 0:
            gh(["repo", "fork", "--remote", "--remote-name", "fork"], "fork the Riemann@home repo", cwd=repo)
        remote, owner = "fork", login
    g("checkout", "-q", "-B", branch, "origin/main")          # reset the branch onto upstream main
    g("reset", "-q", "--hard", "origin/main")
    (repo / rel).parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(src, repo / rel)
    g("add", "--", rel)
    changed = g("diff", "--cached", "--name-only", "origin/main", capture_output=True, text=True).stdout.split()
    if changed != [rel]:
        raise Fail(f"refusing to push: the commit would touch {changed}, expected only {rel}")
    name, email = git_identity(repo, login)
    env = {**os.environ, "GIT_AUTHOR_NAME": name, "GIT_AUTHOR_EMAIL": email,
           "GIT_COMMITTER_NAME": name, "GIT_COMMITTER_EMAIL": email}
    g("-c", f"user.name={name}", "-c", f"user.email={email}", "commit", "-q", "--no-verify", "--no-gpg-sign",
      "-m", f"update: {rec['modules_compiled']} modules", env=env)
    g("push", "-q", "--force", remote, f"HEAD:refs/heads/{branch}")
    if pr["state"] != "open":
        title = f"Riemann@home build {bid} ({login})"
        m = rec["machine"]
        body = (f"Riemann@home build record for one computer (build `{bid}`). The tool updates this pull request "
                f"while the build runs; the bot checks each version.\n\n"
                f"- modules compiled: {rec['modules_compiled']:,} / {N_MODULES:,}\n"
                f"- machine: {m.get('cpu')}, {m.get('cores')} cores, {m.get('os')} ({m.get('arch')})\n")
        url = gh(["pr", "create", "--repo", upstream, "--head", f"{owner}:{branch}", "--base", "main",
                  "--title", title, "--body", body], "open the pull request").strip().splitlines()[-1]
        mm = re.search(r"/pull/(\d+)", url)
        pr.update(state="open", url=url, number=int(mm[1]) if mm else None)
        print(f"opened {url}")
    else:
        print(f"updated {pr['url']}")
    ctx.set_conf(pr={"build_id": bid, "number": pr["number"], "url": pr["url"], "state": "open",
                     "final_sent": bool(rec["final"]), "remote": remote, "upstream": upstream,
                     "pushed": hashlib.sha256(json.dumps(comparable(rec), sort_keys=True).encode()).hexdigest(),
                     "pushed_at": int(time.time())})
    print(f"{rec['modules_compiled']:,} modules -> {rel} on {owner}:{branch}")
    return 0


GH_TIMEOUT = 300


def gh(args: list, what: str, cwd=None) -> str:
    try:
        r = subprocess.run(["gh"] + args, capture_output=True, text=True, cwd=cwd, timeout=GH_TIMEOUT)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise Fail(f"could not {what}: {e}")
    if r.returncode != 0:
        raise Fail(f"could not {what}: {(r.stderr or r.stdout).strip()[:500]}")
    return r.stdout


def git(repo: Path, *args, check=True, **kw):
    kw.setdefault("timeout", GH_TIMEOUT)
    if "capture_output" not in kw and "stdout" not in kw:
        kw.update(capture_output=True, text=True)
    try:
        r = subprocess.run(["git", "-C", str(repo), *args], **kw)
    except subprocess.TimeoutExpired as e:
        raise Fail(f"git {args[0]} timed out: {e}")
    if check and r.returncode != 0:
        raise Fail(f"git {' '.join(args[:2])} failed: {(r.stderr or r.stdout or '').strip()[:500]}")
    return r


def latest_record(ctx: Ctx) -> Path:
    recs = sorted(ctx.records.glob("*.json"))
    if not recs:
        raise Fail("no build record yet; run: riemann-at-home record")
    return recs[-1]


def submit_lock(ctx: Ctx):
    """One submit at a time (the build's auto-submit and a manual one could overlap)."""
    import fcntl
    ctx.home.mkdir(parents=True, exist_ok=True)
    f = open(ctx.home / "submit.lock", "w")
    fcntl.flock(f, fcntl.LOCK_EX)
    return f


def has_consent(ctx: Ctx) -> bool:
    """Agreed with `submit --agree` (or at setup), or already posting before consent existed: a pull request opened
    by an older version counts as agreed (new versions can't open one without the yes)."""
    c = ctx.conf()
    return bool((c.get("consent") or {}).get("agreed")) or bool((c.get("pr") or {}).get("number"))


def need_consent(ctx: Ctx):
    if not has_consent(ctx):
        raise Fail("Nothing is posted until you agree.\n\n" + consent_notice() +
                   "\n\nTo agree: riemann-at-home submit --agree   (optionally --name \"Display Name\")")


def ask_consent(ctx: Ctx):
    """End of setup: show what becomes public and ask once. In a terminal: y/N, then the name. Otherwise (an AI
    assistant running setup) print the notice and how to agree, so the person answers, not the assistant."""
    if has_consent(ctx):
        return
    try:
        login = gh_login()                        # the account the commits will come from: name it
    except Exception:
        print("\nBefore anything can be posted, log into GitHub yourself: gh auth login\n"
              "Then run: riemann-at-home submit --agree   (it shows what becomes public, and asks)")
        return
    print("\n" + consent_notice(login))
    if not sys.stdin.isatty():
        print("\nTo agree: riemann-at-home submit --agree   (optionally --name \"Display Name\")\n"
              "(If an AI assistant is running this: show the person this notice word for word and wait for "
              "their answer.)")
        return
    if input("Post progress? [y/N] ").strip().lower() not in ("y", "yes"):
        print("Not posting. Your build still runs and the local page still works. "
              "Agree later: riemann-at-home submit --agree")
        return
    name = input("Name on the leaderboard (Enter = your GitHub username, or type a display name): ").strip()
    agree(ctx, name or None)


def agree(ctx: Ctx, name=None, upstream=None):
    if name:
        err = name_problem(name)
        if err:
            raise Fail(f"display name {err}")
    check_gh(True)
    login = gh_login()
    print(consent_notice(login) + "\n")
    ctx.set_conf(consent={"agreed": iso(time.time()), "login": login})
    if name:
        ctx.set_conf(display={"display_name": name})
    sc = ctx.conf().get("submit") or {}
    ctx.set_conf(submit={**sc, "auto": True, "upstream": upstream or sc.get("upstream") or UPSTREAM})
    print(f"Agreed. Progress is posted from GitHub account {login} about every {autosubmit_interval(ctx) / 60:g} "
          "minutes while you build" + (f", shown as \"{name}\" on the leaderboard (GitHub shows {login} on the "
                                       "commits and pull request)." if name else f", shown as {login}."))
    ensure_companion(ctx)


def cmd_submit(ctx: Ctx, a):
    if getattr(a, "agree", False):
        agree(ctx, a.name, a.upstream)
        return 0
    if a.interval is not None:
        if a.interval < MIN_INTERVAL:
            raise Fail(f"--interval must be at least {MIN_INTERVAL} seconds")
        sc = ctx.conf().get("submit") or {}
        ctx.set_conf(submit={**sc, "interval": int(a.interval)})
        print(f"auto-submit interval: {int(a.interval)} s (a running build uses it from its next cycle)")
        if not (a.enable_auto or a.disable_auto):
            if sc.get("auto"):
                ensure_companion(ctx)
            return 0
    if a.enable_auto or a.disable_auto:
        sc = ctx.conf().get("submit") or {}
        if a.enable_auto:
            need_consent(ctx)
            check_gh(True)
            ctx.set_conf(submit={**sc, "auto": True, "upstream": a.upstream or sc.get("upstream") or UPSTREAM})
            print(f"auto-submit on: a running build updates its pull request on {a.upstream or sc.get('upstream') or UPSTREAM} "
                  f"every {autosubmit_interval(ctx):g} s (no restart needed). Turn off: riemann-at-home submit --disable-auto")
            ensure_companion(ctx)
        else:
            ctx.set_conf(submit={**sc, "auto": False})
            print("auto-submit off")
        return 0
    if a.repo and not a.dry_run:
        raise Fail(f"--repo is only for --dry-run; real submits use the tool's own clone at {ctx.home / 'repo'}")
    src = Path(a.record) if a.record else latest_record(ctx)
    rec = json.loads(src.read_text())
    errs = validate_record(rec)
    if errs:
        raise Fail(f"{src} is not a valid {FORMAT} record:\n  " + "\n  ".join(errs))
    if not a.no_gh_check:
        check_gh(a.dry_run)
    login = a.login or gh_login()
    if not re.fullmatch(r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})", login):
        raise Fail(f"{login!r} does not look like a GitHub login")
    repo = Path(a.repo).expanduser().resolve() if a.repo else ctx.home / "repo"
    upstream = a.upstream or (ctx.conf().get("submit") or {}).get("upstream")
    if not upstream and a.repo:
        url = subprocess.run(["git", "-C", str(repo), "remote", "get-url", "origin"], capture_output=True,
                             text=True).stdout.strip()
        m = re.search(r"github\.com[:/]([^/]+/[^/]+?)(?:\.git)?$", url)
        upstream = m[1] if m else None
    upstream = upstream or UPSTREAM
    if not a.dry_run:
        need_consent(ctx)
        with submit_lock(ctx):
            return submit_real(ctx, a, src, rec, login, upstream)
    bid = rec["build_id"]
    rel = f"submissions/{login}/{bid}.json"      # one file per build, overwritten on each update
    pr = pr_state(ctx, repo, upstream, rel, bid, check_github=not a.no_gh_check)
    if pr["done"]:
        raise Fail(f"build {bid} is finished ({pr['done']}); nothing more is submitted for it. "
                   "A new build on another computer gets its own build_id from `riemann-at-home setup`.")
    branch = f"rah/{bid}"                         # one branch and one PR for the build's whole life
    g = ["git", "-C", str(repo)]
    plan = ([] if (repo / ".git").exists() else [["gh", "repo", "clone", upstream, str(repo)]]) + [
        g + ["fetch", "origin", "main"], ["gh", "api", f"repos/{upstream}", "--jq", ".permissions.push"],
        ["# if that is not true:", "gh", "repo", "fork", "--remote", "--remote-name", "fork"],
        g + ["checkout", "-B", branch, "origin/main"], ["cp", str(src), str(repo / rel)], g + ["add", rel],
        g + ["commit", "-m", f"update: {rec['modules_compiled']} modules"],
        g + ["push", "--force", "origin (or fork)", f"HEAD:refs/heads/{branch}"]]
    if pr["state"] == "open":
        head = "update the open PR (quiet: no new PR)"
    else:
        plan.append(["gh", "pr", "create", "--repo", upstream, "--head", f"<{upstream.split('/')[0]} or {login}>:{branch}",
                     "--base", "main", "--title", f"Riemann@home build {bid} ({login})", "--body", "..."])
        head = "open this build's one PR"
    print(f"DRY RUN: nothing is written, committed, pushed or opened.\nrecord: {src}\nas:     {rel} on branch {branch}\n"
          f"step:   {head} -> {upstream}\nwould run:")
    for c in plan:
        print("  " + shlex.join(c))
    return 0


def autosubmit_interval(ctx: Ctx) -> float:
    """Seconds between auto-submits: `submit --interval` (config.json), else 600 (or RAH_AUTOSUBMIT_SECONDS)."""
    v = (ctx.conf().get("submit") or {}).get("interval")
    return max(MIN_INTERVAL, float(v)) if isinstance(v, (int, float)) else AUTOSUBMIT_SECONDS


def old_supervisor(ctx: Ctx):
    """pid of a running supervisor started before this version (fixed 10-minute cycle, calls `record`), else None."""
    sup = supervisor(ctx)
    if not sup:
        return None
    return None if read(ctx.logs / "supervisor.features").split()[:1] == [str(sup)] else sup


def ensure_companion(ctx: Ctx):
    """For a build whose supervisor predates the configurable interval: a small background loop that runs
    `_autosubmit` at the configured interval while that build runs and auto-submit is on. The build itself is not
    touched or restarted."""
    sup = old_supervisor(ctx)
    pidf = ctx.logs / "autosubmit-loop.pid"
    pid = read_pid(pidf)
    if not sup or (pid and pid_alive(pid, "_autosubmit_loop")):
        return
    with open(ctx.logs / "autosubmit.log", "ab") as lf:
        p = subprocess.Popen([sys.executable, "-I", str(Path(__file__).resolve()), "_autosubmit_loop", "--folder",
                              str(ctx.folder), "--logs", str(ctx.logs)], stdin=subprocess.DEVNULL, stdout=lf,
                             stderr=lf, start_new_session=True, env={**os.environ, "RAH_HOME": str(ctx.home)})
    pidf.write_text(str(p.pid))


def cmd_autosubmit_loop(ctx: Ctx, a):
    """The companion loop (see ensure_companion). Ends when the build stops or auto-submit is turned off."""
    sup = old_supervisor(ctx)
    me = [sys.executable, "-I", str(Path(__file__).resolve()), "_autosubmit", "--folder", str(ctx.folder),
          "--logs", str(ctx.logs)]
    while sup and supervisor(ctx) == sup and (ctx.conf().get("submit") or {}).get("auto"):
        time.sleep(autosubmit_interval(ctx))
        if supervisor(ctx) != sup or not (ctx.conf().get("submit") or {}).get("auto"):
            break
        with open(ctx.logs / "autosubmit.log", "a") as f:
            f.write(f"--- autosubmit (progress, every {autosubmit_interval(ctx):g} s) {iso(time.time())}\n")
            f.flush()
            try:
                subprocess.run(me, stdout=f, stderr=subprocess.STDOUT, env={**os.environ, "RAH_HOME": str(ctx.home)},
                               timeout=6 * 3600)
            except Exception as e:
                f.write(f"autosubmit failed: {e}\n")
    (ctx.logs / "autosubmit-loop.pid").unlink(missing_ok=True)
    return 0


def cmd_autosubmit(ctx: Ctx, a):
    """What the build supervisor runs about every 10 minutes: write a record, then, if auto-submit is on, update
    this build's PR. Rereads config.json each time. Never fails the build: errors are printed (to the log)."""
    try:
        if a.cmd != "record":                     # (an older supervisor calls `record`, which already wrote one)
            rec = make_record(ctx, a)
            out = write_record(ctx, rec)
            print(f"{rec['modules_compiled']:,} / {N_MODULES:,} modules\n{out}")
        sc = ctx.conf().get("submit") or {}
        if sc.get("auto"):
            ns = argparse.Namespace(enable_auto=False, disable_auto=False, interval=None, repo=None, record=None, login=None,
                                    upstream=sc.get("upstream") or UPSTREAM, dry_run=False, no_gh_check=False)
            cmd_submit(ctx, ns)
        elif ctx.conf().get("repo"):              # older setting: dry run into a given clone
            ns = argparse.Namespace(enable_auto=False, disable_auto=False, interval=None, repo=ctx.conf()["repo"], record=None,
                                    login=None, upstream=None, dry_run=True, no_gh_check=False)
            cmd_submit(ctx, ns)
        else:
            print("auto-submit is off (turn on: riemann-at-home submit --enable-auto)")
    except Fail as e:
        print(f"auto-submit: {e} (the build goes on; next try in about 10 minutes)")
    except Exception as e:                        # network, git, anything: log it, keep building
        print(f"auto-submit failed: {type(e).__name__}: {e} (the build goes on)")
    return 0


def called_by_supervisor(ctx: Ctx) -> bool:
    sup = supervisor(ctx)
    return bool(sup) and os.getppid() == sup



# ---------------------------------------------------------------- levels: export, recheck, joint statement

def levels_state(ctx: Ctx, digest: str = None) -> dict:
    """Export / checker / signature results kept in config.json, tied to this build_id and to the olean digest
    of the whole build they were made from (a different folder state does not inherit them)."""
    lv = ctx.conf().get("levels") or {}
    if lv.get("build_id") != ctx.build_id(create=False) or (digest and lv.get("olean_digest") != digest):
        return {}
    return lv


def level_fields(ctx: Ctx, rec: dict) -> dict:
    """The optional record fields earned so far. Only a reproduced export goes into a record (the bot rejects any
    other export hash); checkers and the signature only on top of that."""
    if not rec.get("whole_proof"):
        return {}
    out = {}
    ep = export_progress(ctx, rec["olean_digest"])
    if ep:
        out["export_progress"] = ep
    lv = levels_state(ctx, rec["olean_digest"])
    ex = lv.get("export") or {}
    if ex.get("sha256") != EXPORT_SHA256:
        return out
    out.update({"export_sha256": ex["sha256"], "export_bytes": ex["bytes"]})
    if lv.get("checkers"):
        out["checkers"] = lv["checkers"]
    if lv.get("sign_statement") is True:
        out["sign_statement"] = True
    return out


def whole_build(ctx: Ctx, a, what: str) -> dict:
    """A record of the build, which must be whole with the axiom check passed."""
    rec = make_record(ctx, a)
    if not rec["whole_proof"]:
        raise Fail(f"{what} needs the whole build first: {rec['modules_compiled']:,} / {N_MODULES:,} modules compiled "
                   "and the axiom check run (`riemann-at-home build` runs it when the build finishes)")
    if sorted(rec["axioms"]) != sorted(EXPECTED_AXIOMS):
        raise Fail(f"{what} needs a passing axiom check; riemannHypothesis depends on {rec['axioms']}, "
                   f"expected {EXPECTED_AXIOMS}")
    return rec


def exporter_command(ctx: Ctx, a) -> list:
    """`lake env <lean4export> Main`, run in the build folder. lean4export is built once from the pinned tag into
    ~/.riemann-at-home/tools with the toolchain that tag pins."""
    if getattr(a, "exporter", None):                         # testing: a stand-in exporter
        return [a.exporter, "Main"]
    src = ctx.home / "tools" / f"lean4export-{EXPORTER_TAG}"
    exe = src / ".lake/build/bin/lean4export"
    if not exe.exists():
        if not src.exists():
            src.parent.mkdir(parents=True, exist_ok=True)
            tmp = src.with_name(src.name + f".cloning-{os.getpid()}")
            if run(["git", "clone", "-q", "--depth", "1", "--branch", EXPORTER_TAG, EXPORTER_REPO, tmp]).returncode != 0:
                shutil.rmtree(tmp, ignore_errors=True)
                raise Fail(f"could not download lean4export {EXPORTER_TAG} from {EXPORTER_REPO}")
            tmp.rename(src)
        tc = toolchain_of(src)
        if not tc:
            raise Fail(f"{src} has no lean-toolchain")
        elan = ensure_elan()
        if not toolchain_installed(elan, tc):
            print(f"installing {tc} (the toolchain lean4export {EXPORTER_TAG} pins)")
            if run([elan, "toolchain", "install", tc], env=lean_env()).returncode != 0:
                raise Fail(f"could not install {tc}")
        print(f"building lean4export {EXPORTER_TAG} with {tc}")
        if run([which("lake") or "lake", "build"], cwd=src, env=lean_env()).returncode != 0 or not exe.exists():
            raise Fail(f"building lean4export failed (in {src})")
    return [which("lake") or "lake", "env", str(exe), "Main"]


def export_progress(ctx: Ctx, digest: str):
    """The record's export_progress for this build and olean digest: progress while `export` runs, the result once
    done. An unfinished export not updated for EXPORT_STALE seconds (stopped, crashed) is left out."""
    try:
        p = json.loads((ctx.home / "export-progress.json").read_text())
    except (OSError, ValueError):
        return None
    if p.get("build_id") != ctx.build_id(create=False) or p.get("olean_digest") != digest:
        return None
    if not p.get("done") and time.time() - p.get("updated", 0) > EXPORT_STALE:
        return None
    return {k: p.get(k) for k in EXPORT_PROGRESS_FIELDS}


def tree_memory_gb(root: int) -> float:
    """Resident memory of a process and all its descendants, in GB (the exporter runs under nice and lake env)."""
    try:
        out = subprocess.run(["ps", "-A", "-o", "pid=,ppid=,rss="], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return 0.0
    kids, rss = {}, {}
    for line in out.splitlines():
        f = line.split()
        if len(f) == 3 and all(x.isdigit() for x in f):
            kids.setdefault(int(f[1]), []).append(int(f[0])); rss[int(f[0])] = int(f[2])
    total, todo = 0, [root]
    while todo:
        p = todo.pop(); total += rss.get(p, 0); todo += kids.get(p, [])
    return total / 2 ** 20                                   # ps reports KiB


def fmt_dur(t: float) -> str:
    t = int(t)
    return f"{max(1, round(t / 60))} m" if t < 3600 else f"{t // 3600} h {round(t % 3600 / 60)} m"


def stream_export(ctx: Ctx, cmd: list, log: Path, sink=None, on_progress=None) -> tuple:
    """Run the exporter in the build folder at nice 19 and read its stdout straight into sha256 and a byte counter
    (and into `sink`, a checker's stdin, if given). Nothing is written to disk. -> (exit code, sha256, bytes)."""
    h, n = hashlib.sha256(), 0
    print("  $ " + shlex.join(map(str, cmd)) + f"   (in {ctx.folder}; output hashed, not stored)", file=sys.stderr)
    with open(log, "ab") as lf:
        p = subprocess.Popen(["nice", "-n", "19"] + list(map(str, cmd)), cwd=ctx.folder, stdin=subprocess.DEVNULL,
                             stdout=subprocess.PIPE, stderr=lf, env=lean_env())
    t0 = time.time()
    st = {"peak": 0.0, "next_mem": 0.0, "next_show": 0.0, "pct": -1}
    tty = sys.stderr.isatty()

    def show(final=False):
        el = time.time() - t0
        left = (EXPORT_BYTES - n) / (n / el) if n and el >= 60 and n < EXPORT_BYTES else None
        pct = min(100, int(n * 100 / EXPORT_BYTES))
        if on_progress:
            on_progress(n, el, left, st["peak"], final)
        if not tty and not final and pct == st["pct"]:      # logs: one line per percent
            return
        st["pct"] = pct
        bar = "█" * (pct * 22 // 100) + "░" * (22 - pct * 22 // 100)
        line = (f"  EXPORTING {pct}%  {bar}  {n / 1e9:,.1f} of {EXPORT_BYTES / 1e9:,.1f} GB · {n / 1e6 / max(el, 1):,.1f} MB/s"
                + (f" · about {fmt_dur(left)} left" if left else "") + (f" · memory {st['peak']:,.0f} GB" if st["peak"] else ""))
        print(("\r" + line.ljust(110)) if tty else line, end="" if tty and not final else "\n", file=sys.stderr, flush=True)

    try:
        for chunk in iter(lambda: p.stdout.read(1 << 20), b""):
            h.update(chunk)
            n += len(chunk)
            if sink is not None:
                sink.write(chunk)
            now = time.time()
            if now >= st["next_mem"]:                         # peak memory of the exporter (and lake env) every 5 s
                st["peak"], st["next_mem"] = max(st["peak"], tree_memory_gb(p.pid)), now + 5
            if now >= st["next_show"]:
                show(); st["next_show"] = now + (1 if tty else 30)
    except BrokenPipeError:                                   # the checker stopped reading
        p.kill()
    finally:
        p.stdout.close()
    rc = p.wait()
    show(final=True)
    return rc, h.hexdigest(), n


def cmd_export(ctx: Ctx, a):
    """Level 2: export the compiled proof with lean4export and compare it with the reference export."""
    rec = whole_build(ctx, a, "export")
    cmd = exporter_command(ctx, a)
    ctx.logs.mkdir(parents=True, exist_ok=True)
    log = ctx.logs / "export.log"
    print(f"exporting the proof: {EXPORT_BYTES / 1e9:.1f} GB of output, hashed as it streams (nothing written to disk)")
    t0 = time.time()
    pf = ctx.home / "export-progress.json"
    base = {"build_id": rec["build_id"], "olean_digest": rec["olean_digest"]}
    auto = AUTOSUBMIT != "off" and bool((ctx.conf().get("submit") or {}).get("auto"))
    sent = {"at": time.time()}

    def progress(n, el, left, peak, final):
        pf.write_text(json.dumps({**base, "bytes": n, "seconds": int(el), "left_seconds": None if final or left is None
                                  else int(left), "peak_memory_gb": round(peak, 2) if peak else None, "done": False,
                                  "updated": int(time.time())}) + "\n")
        if auto and not final and time.time() - sent["at"] >= autosubmit_interval(ctx):   # the leaderboard's gold bar
            sent["at"] = time.time()
            threading.Thread(target=autosubmit, args=(ctx, a, "export progress"), daemon=True).start()

    rc, sha, n = stream_export(ctx, cmd, log, on_progress=progress)
    if rc != 0:
        pf.unlink(missing_ok=True)
        raise Fail(f"the exporter exited with {rc}; see {log}")
    match = sha == EXPORT_SHA256 and n == EXPORT_BYTES
    last = json.loads(pf.read_text())
    pf.write_text(json.dumps({**last, "done": True, "left_seconds": None, "updated": int(time.time())}) + "\n")
    peak = f", peak memory {last['peak_memory_gb']:,.0f} GB" if last.get("peak_memory_gb") else ""
    lv = levels_state(ctx, rec["olean_digest"])
    same = (lv.get("export") or {}).get("sha256") == sha
    ctx.set_conf(levels={"build_id": rec["build_id"], "olean_digest": rec["olean_digest"],
                         "export": {"sha256": sha, "bytes": n, "exporter": f"lean4export {EXPORTER_TAG}",
                                    "seconds": int(time.time() - t0), "when": iso(time.time())},
                         "checkers": lv.get("checkers", []) if same else [],
                         "sign_statement": bool(lv.get("sign_statement")) and same and match})
    print(f"export sha256 {sha}\nexport bytes  {n:,}")
    if auto:
        autosubmit(ctx, a, "export done")                   # the leaderboard shows the result (and Level 2 if it matches)
    if not match:
        print(f"reference     {EXPORT_SHA256}, {EXPORT_BYTES:,} bytes (Andrew Sutherland, https://math.mit.edu/~drew/grh)")
        print("does not match the reference, so records do not carry it.")
        print(UNVERIFIED)
        return 1
    print(f"export matches the reference ✓  ({fmt_dur(time.time() - t0)}{peak})")
    print("Level 2: matches the reference export (Andrew Sutherland, https://math.mit.edu/~drew/grh).")
    out = write_record(ctx, make_record(ctx, a))
    print(f"record with export_sha256: {out}")
    return 0


def total_ram_gb() -> float:
    if os.environ.get("RAH_TEST_RAM_GB"):                    # testing only
        return float(os.environ["RAH_TEST_RAM_GB"])
    if IS_MAC:
        r = subprocess.run(["sysctl", "-n", "hw.memsize"], capture_output=True, text=True).stdout.strip()
        return int(r) / 2 ** 30 if r.isdigit() else 0.0
    m = re.search(r"^MemTotal:\s+(\d+) kB", read(Path("/proc/meminfo")), re.M)
    return int(m[1]) / 2 ** 20 if m else 0.0


def cmd_recheck(ctx: Ctx, a):
    """Level 3 (optional): stream the export into an independent checker (it reads the export on stdin)."""
    name = "nanoda" if a.nanoda else "con-leche"
    need, ram = CHECKERS[name], total_ram_gb()
    if ram < need:
        raise Fail(f"{name} needs about {need} GB of memory; this computer has {ram:.0f} GB. "
                   "Level 3 is optional: a computer with more memory can run it.")
    rec = whole_build(ctx, a, "recheck")
    lv = levels_state(ctx, rec["olean_digest"])
    if (lv.get("export") or {}).get("sha256") != EXPORT_SHA256:
        raise Fail("recheck needs Level 2 first: run `riemann-at-home export` and reproduce the reference export")
    exe = a.checker or shutil.which(name) or str(ctx.home / "tools/bin" / name)
    if not Path(exe).exists():
        raise Fail(f"{name} is not installed. Build it from its project, then put it at "
                   f"{ctx.home / 'tools/bin' / name} or pass --checker PATH")
    version = a.checker_version
    if not version:
        try:
            v = subprocess.run([exe, "--version"], capture_output=True, text=True, timeout=30)
            version = (v.stdout or v.stderr).strip().splitlines()[0][:64] if v.returncode == 0 else ""
        except (OSError, subprocess.TimeoutExpired, IndexError):
            version = ""
    version = version or "unknown"
    log = ctx.logs / f"recheck-{name}.log"
    ctx.logs.mkdir(parents=True, exist_ok=True)
    ccmd = [exe] + shlex.split(a.checker_args or "")
    print(f"re-checking the export with {name} {version} (needs about {need} GB of memory; takes hours)")
    print("  $ " + shlex.join(ccmd) + "   (export on stdin)", file=sys.stderr)
    t0 = time.time()
    with open(log, "ab") as lf:
        chk = subprocess.Popen(ccmd, cwd=ctx.home, stdin=subprocess.PIPE, stdout=lf, stderr=subprocess.STDOUT)
        rc, sha, n = stream_export(ctx, exporter_command(ctx, a), ctx.logs / "export.log", sink=chk.stdin)
        try:
            chk.stdin.close()
        except BrokenPipeError:
            pass
        crc = chk.wait()
    secs = int(time.time() - t0)
    if sha != EXPORT_SHA256 or n != EXPORT_BYTES:
        raise Fail(f"the export streamed to {name} was not the reference export (sha256 {sha}, {n:,} bytes, exporter "
                   f"exit {rc}); nothing recorded. See {ctx.logs / 'export.log'}")
    result = "accept" if crc == 0 else "reject"
    entry = {"name": name, "version": version, "result": result, "seconds": secs}
    lv = levels_state(ctx, rec["olean_digest"])
    lv["checkers"] = [e for e in lv.get("checkers", []) if e.get("name") != name] + [entry]
    ctx.set_conf(levels=lv)
    print(f"{name}: {result.upper()} in {secs / 3600:.1f} h (log: {log})")
    out = write_record(ctx, make_record(ctx, a))
    print(f"{'Level 3. ' if result == 'accept' else ''}record with checkers: {out}")
    return 0 if result == "accept" else 1


README = Path(__file__).resolve().parent / "README.md"       # shipped next to this script


def statement_text() -> str:
    """The joint statement, word for word from the README's "## Joint statement" section."""
    m = re.search(r"^## Joint statement[ \t]*\n(.*?)(?=^## |\Z)", read(README), re.M | re.S)
    text = " ".join(m[1].split()) if m else ""
    if not text.startswith("Riemann@home: a joint statement"):
        raise Fail(f"the joint statement is missing from {README} (it ships next to this tool)")
    return text


def cmd_sign(ctx: Ctx, a):
    """Sign the joint statement: allowed at Level 2 or 3. Shows the text and asks first."""
    rec = whole_build(ctx, a, "signing")
    if record_level(rec) < 2:
        raise Fail("signing needs Level 2: a whole build whose export reproduces the reference "
                   "(run `riemann-at-home export`)")
    import textwrap
    print("\n" + textwrap.fill(statement_text(), 100) + "\n")
    print(f"You are at Level {record_level(rec)}. Your signature is your own report, tied to your GitHub account.")
    try:
        yes = input("Sign this statement? [y/N] ").strip().lower() in ("y", "yes")
    except EOFError:
        yes = False
    if not yes:
        print("not signed")
        return 1
    lv = levels_state(ctx, rec["olean_digest"])
    lv["sign_statement"] = True
    ctx.set_conf(levels=lv)
    out = write_record(ctx, make_record(ctx, a))
    print(f"signed: records now carry \"sign_statement\": true; the next update of this build's PR sends it.\n{out}")
    return 0


