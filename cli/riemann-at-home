class Ctx:
    def __init__(self, a):
        self.home = Path(os.environ.get("RAH_HOME") or Path.home() / ".riemann-at-home")
        self.folder = Path(a.folder) if getattr(a, "folder", None) else fixed_folder()
        self.logs = Path(a.logs) if getattr(a, "logs", None) else self.home / "logs"
        self.records = self.home / "records"
        self.status = self.logs / "status.txt"
        self.samples = self.logs / "samples.txt"
        self.mode_file = self.logs / "mode.txt"
        self.pid_file = self.logs / "build.pid"      # supervisor (this script, `_run`)
        self.pgid_file = self.logs / "build.pgid"    # process group of time/nice/lake/lean
        self.caff_file = self.logs / "caffeinate.pid"
        self.build_id_file = self.home / "build_id"
        self.config = self.home / "config.json"

    def build_id(self, create=True) -> str:
        """Random per-computer id (16 hex chars), made once by setup and kept."""
        b = read(self.build_id_file).strip()
        if re.fullmatch(r"[0-9a-f]{16}", b) or not create:
            return b or None
        b = secrets.token_hex(8)
        self.home.mkdir(parents=True, exist_ok=True)
        self.build_id_file.write_text(b + "\n")
        return b

    def conf(self) -> dict:
        try:
            return json.loads(self.config.read_text())
        except (OSError, ValueError):
            return {}

    def set_conf(self, **kw):
        c = {**self.conf(), **kw}
        self.home.mkdir(parents=True, exist_ok=True)
        self.config.write_text(json.dumps(c, indent=1) + "\n")

    @property
    def lib(self) -> Path:
        return self.folder / ".lake/build/lib/lean"


def now_utc() -> datetime:
    return datetime.now(timezone.utc)


def iso(t: float) -> str:
    return datetime.fromtimestamp(t, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def parse_time(s: str):
    """ISO `2026-11-21T15:26:31Z`, or an older build-script form `2026-11-21 07:26:31 PST` (local time)."""
    s = s.strip()
    try:
        return datetime.strptime(s[:20], "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc).timestamp()
    except ValueError:
        pass
    m = re.match(r"(\d{4}-\d\d-\d\d) (\d\d:\d\d:\d\d)", s)
    if m:
        return time.mktime(time.strptime(f"{m[1]} {m[2]}", "%Y-%m-%d %H:%M:%S"))
    return None


def log_event(ctx: Ctx, kind: str, t: float = None):
    ctx.logs.mkdir(parents=True, exist_ok=True)
    with open(ctx.status, "a") as f:
        f.write(f"{kind} {iso(t or time.time())}\n")


def sha256_file(p: Path) -> str:
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def elan_bin() -> Path:
    return Path(os.environ.get("ELAN_HOME") or Path.home() / ".elan") / "bin"


def lean_env() -> dict:
    env = dict(os.environ)
    env["PATH"] = f"{elan_bin()}:{env.get('PATH', '')}"
    return env


def which(name: str):
    p = elan_bin() / name
    return str(p) if p.exists() else shutil.which(name)


def run(cmd, **kw):
    print("  $ " + shlex.join(map(str, cmd)), file=sys.stderr)
    return subprocess.run(list(map(str, cmd)), **kw)


def read(p: Path, default=""):
    try:
        return p.read_text()
    except OSError:
        return default


# ---------------------------------------------------------------- module list, bitmap, digest

def all_modules(folder: Path) -> list:
    """All src/**/*.lean as dotted names, sorted byte-wise (UTF-8 byte order == code point order)."""
    src = folder / "src"
    out = []
    for root, dirs, files in os.walk(src):
        rel = os.path.relpath(root, src)
        for f in files:
            if f.endswith(".lean"):
                out.append((f[:-5] if rel == "." else f"{rel}/{f[:-5]}").replace(os.sep, ".").replace("/", "."))
    return sorted(out, key=lambda m: m.encode())


def compiled_modules(lib: Path) -> set:
    """Modules Lake has finished: both `.olean` and `.trace` present. Lake writes the trace last, so an
    .olean without one (a build stopped mid-module) is not finished and Lake rebuilds it."""
    out = set()
    for root, _, files in os.walk(lib):
        rel = os.path.relpath(root, lib)
        fs = set(files)
        for f in files:
            if f.endswith(".olean") and f[:-6] + ".trace" in fs:
                out.add((f[:-6] if rel == "." else f"{rel}/{f[:-6]}").replace(os.sep, "."))
    return out


def count_compiled(lib: Path) -> int:
    return len(compiled_modules(lib))


def encode_bitmap(bits: list) -> str:
    """bit i = module i compiled, LSB-first within each byte, gzip (mtime 0) then base64."""
    b = bytearray((len(bits) + 7) // 8)
    for i, on in enumerate(bits):
        if on:
            b[i >> 3] |= 1 << (i & 7)
    return base64.b64encode(gzip.compress(bytes(b), compresslevel=9, mtime=0)).decode()


def decode_bitmap(b64: str, n: int) -> list:
    b = gzip.decompress(base64.b64decode(b64))
    if len(b) != (n + 7) // 8:
        raise ValueError(f"bitmap is {len(b)} bytes, expected {(n + 7) // 8}")
    return [bool(b[i >> 3] >> (i & 7) & 1) for i in range(n)]


class HashCache:
    """sha256 of each .olean, keyed by (path, size, mtime), so repeat records only hash new files."""
    def __init__(self, path: Path):
        self.path, self.d = path, {}
        try:
            self.d = json.loads(path.read_text())
        except (OSError, ValueError):
            pass

    def get(self, p: Path) -> bytes:
        st = p.stat()
        key = str(p)
        e = self.d.get(key)
        if e and e[0] == st.st_size and e[1] == st.st_mtime_ns:
            return bytes.fromhex(e[2])
        h = sha256_file(p)
        self.d[key] = [st.st_size, st.st_mtime_ns, h]
        return bytes.fromhex(h)

    def save(self):
        self.path.parent.mkdir(parents=True, exist_ok=True)
        tmp = self.path.with_suffix(".tmp")
        tmp.write_text(json.dumps(self.d))
        tmp.replace(self.path)


def olean_digest(lib: Path, mods: list, bits: list, cache: HashCache = None) -> str:
    """sha256 over sha256(.olean bytes) (32 raw bytes each) of each compiled module, in index order."""
    h = hashlib.sha256()
    for m, on in zip(mods, bits):
        if on:
            p = lib / (m.replace(".", "/") + ".olean")
            h.update(cache.get(p) if cache else bytes.fromhex(sha256_file(p)))
    return h.hexdigest()


# ---------------------------------------------------------------- machine, logs, busy time

def machine() -> dict:
    cpu = ""
    if IS_MAC:
        cpu = subprocess.run(["sysctl", "-n", "machdep.cpu.brand_string"], capture_output=True, text=True).stdout.strip()
    else:
        m = re.search(r"^model name\s*:\s*(.+)$", read(Path("/proc/cpuinfo")), re.M)
        cpu = m[1].strip() if m else ""
    return {"os": f"{platform.system()} {platform.release()}", "arch": platform.machine(),
            "cpu": cpu or platform.processor() or "", "cores": int(os.cpu_count() or 0)}


def events(ctx: Ctx) -> list:
    out = []
    for line in read(ctx.status).splitlines():
        kind, _, rest = line.partition(" ")
        t = parse_time(rest)
        if t is not None:
            out.append((kind.split("=")[0], kind, t))
    return out


def samples(ctx: Ctx) -> list:
    """(time, modules compiled) from samples.txt; either timestamp form."""
    out = []
    for line in read(ctx.samples).splitlines():
        m = re.match(r"(\S+(?: \d\d:\d\d:\d\d)?)\s+(?:oleans|modules)=(\d+)", line)
        if m:
            t = parse_time(m[1])
            if t is not None:
                out.append((t, int(m[2])))
    return out


def busy_seconds(ctx: Ctx, running: bool, now: float = None) -> tuple:
    """(started, busy seconds): wall time the build was running, summed over sessions, minus pauses.
    A session opens at START/RESTART and closes at BUILD_EXIT. A session with no BUILD_EXIT (the build was
    killed) closes at its last sign of life: the last sample, or the build log's last write."""
    now = now or time.time()
    ev = events(ctx)
    smp = [t for t, _ in samples(ctx)]
    started = next((t for k, _, t in ev if k == "START"), None) or next((t for k, _, t in ev if k == "RESTART"), None)
    total, open_at, paused_at, paused = 0.0, None, None, 0.0

    def last_alive(after, before):
        cands = [t for t in smp if after <= t <= before]
        for p in (ctx.logs / "build.log", ctx.logs / "time.txt"):
            try:
                mt = p.stat().st_mtime
                if after <= mt <= before:
                    cands.append(mt)
            except OSError:
                pass
        return max(cands) if cands else after

    def close(end):
        nonlocal total, open_at, paused_at, paused
        if paused_at is not None:
            paused += max(0.0, end - paused_at)
        total += max(0.0, end - open_at - paused)
        open_at, paused_at, paused = None, None, 0.0

    for i, (k, _, t) in enumerate(ev):
        if k in ("START", "RESTART"):
            if open_at is not None:
                close(last_alive(open_at, t))
            open_at = t
        elif open_at is None:
            continue
        elif k == "PAUSE" and paused_at is None:
            paused_at = t
        elif k == "RESUME" and paused_at is not None:
            paused += t - paused_at
            paused_at = None
        elif k == "BUILD_EXIT":
            close(t)
    if open_at is not None:
        close(now if running else last_alive(open_at, now))
    return started, int(round(total))


def parse_axioms(text: str):
    """The axioms Lean prints for riemannHypothesis, or None if the check did not print them."""
    m = re.search(r"'riemannHypothesis' depends on axioms:\s*\[([^\]]*)\]", text)
    if m:
        return [a.strip() for a in m[1].split(",") if a.strip()]
    if re.search(r"'riemannHypothesis' does not depend on any axioms", text):
        return []
    return None


# ---------------------------------------------------------------- processes

def ps_table() -> list:
    out = subprocess.run(["ps", "-axo", "pid=,pgid=,stat=,comm="], capture_output=True, text=True).stdout
    rows = []
    for line in out.splitlines():
        parts = line.split(None, 3)
        if len(parts) == 4:
            rows.append((int(parts[0]), int(parts[1]), parts[2], os.path.basename(parts[3])))
    return rows


def pid_alive(pid: int, must_contain: str = None) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        pass
    if must_contain:
        cmd = subprocess.run(["ps", "-o", "command=", "-p", str(pid)], capture_output=True, text=True).stdout
        return must_contain in cmd
    return True


def read_pid(p: Path):
    try:
        return int(p.read_text().strip())
    except (OSError, ValueError):
        return None


def supervisor(ctx: Ctx):
    pid = read_pid(ctx.pid_file)
    return pid if pid and pid_alive(pid, " _run") else None


def outside_build(ctx: Ctx) -> list:
    """lake processes working in this folder that this tool did not start (e.g. an older build script).
    Two builds in one folder would fight over the same files, so `build` refuses while one runs."""
    pgid = read_pid(ctx.pgid_file)
    ours = {p for p, g, _, _ in ps_table() if pgid and g == pgid}
    found = []
    for pid, _, _, comm in ps_table():
        if comm != "lake" or pid in ours:
            continue
        r = subprocess.run(["lsof", "-a", "-d", "cwd", "-p", str(pid), "-Fn"], capture_output=True, text=True)
        cwd = next((l[1:] for l in r.stdout.splitlines() if l.startswith("n")), None)
        if cwd is None and Path(f"/proc/{pid}/cwd").exists():
            try:
                cwd = os.readlink(f"/proc/{pid}/cwd")
            except OSError:
                pass
        if cwd and os.path.realpath(cwd) == os.path.realpath(ctx.folder):
            found.append(pid)
    return found


def group_procs(pgid: int) -> list:
    return [r for r in ps_table() if r[1] == pgid]


def is_paused(ctx: Ctx) -> bool:
    ev = [k for k, _, _ in events(ctx) if k in ("PAUSE", "RESUME", "START", "RESTART", "BUILD_EXIT")]
    return bool(ev) and ev[-1] == "PAUSE"


def set_priority(pids: list, mode: str):
    """gentle = background policy (macOS taskpolicy -b / Linux SCHED_IDLE); full = normal (still nice 19)."""
    for pid in pids:
        if IS_MAC:
            subprocess.run(["taskpolicy", "-b" if mode == "gentle" else "-B", "-p", str(pid)], capture_output=True)
        elif hasattr(os, "sched_setscheduler"):
            try:
                pol = os.SCHED_IDLE if mode == "gentle" else os.SCHED_OTHER
                os.sched_setscheduler(pid, pol, os.sched_param(0))
            except OSError:
                pass


def build_pids(ctx: Ctx, names=("lake", "lean")) -> list:
    pgid = read_pid(ctx.pgid_file)
    return [p for p, _, _, c in group_procs(pgid) if c in names] if pgid else []


def start_caffeinate(ctx: Ctx, pgid: int):
    """Keep the Mac from idle-sleeping while the build runs (released while paused)."""
    if IS_MAC and shutil.which("caffeinate"):
        c = subprocess.Popen(["caffeinate", "-i", "-w", str(pgid)], stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        ctx.caff_file.write_text(str(c.pid))


def stop_caffeinate(ctx: Ctx):
    pid = read_pid(ctx.caff_file)
    if pid and pid_alive(pid, "caffeinate"):
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
    ctx.caff_file.unlink(missing_ok=True)


