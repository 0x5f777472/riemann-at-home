def download_archive(ctx: Ctx, url_template: str) -> Path:
    dl = ctx.home / "download"
    dl.mkdir(parents=True, exist_ok=True)
    out = dl / "lean.tar.gz"
    if out.exists() and out.stat().st_size == ARCHIVE_BYTES and sha256_file(out) == ARCHIVE_SHA256:
        print(f"archive already downloaded and verified: {out}")
        return out
    for i in range(1, PARTS + 1):
        nn = f"{i:02d}"
        part = dl / f"lean.tar.gz.part{nn}"
        url = url_template.format(nn=nn)
        req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
        with urllib.request.urlopen(req, timeout=120) as r:
            size = r.headers.get("Content-Length")
            if part.exists() and size and part.stat().st_size == int(size):
                print(f"  part {nn}/{PARTS} already here")
                continue
            print(f"  part {nn}/{PARTS} <- {url}")
            tmp = part.with_suffix(".tmp")
            with open(tmp, "wb") as f:
                shutil.copyfileobj(r, f, 1 << 20)
            tmp.replace(part)
    h = hashlib.sha256()
    tmp = out.with_suffix(".tmp")
    with open(tmp, "wb") as f:
        for i in range(1, PARTS + 1):
            with open(dl / f"lean.tar.gz.part{i:02d}", "rb") as p:
                for chunk in iter(lambda: p.read(1 << 20), b""):
                    h.update(chunk)
                    f.write(chunk)
    if h.hexdigest() != ARCHIVE_SHA256:
        tmp.unlink()
        raise Fail(f"downloaded archive has sha256 {h.hexdigest()}, expected {ARCHIVE_SHA256}; parts kept in {dl} "
                   "(delete them to download again)")
    tmp.replace(out)
    for i in range(1, PARTS + 1):
        (dl / f"lean.tar.gz.part{i:02d}").unlink(missing_ok=True)
    return out


def unpack(archive: Path, folder: Path):
    parent = folder.parent
    try:
        parent.mkdir(parents=True, exist_ok=True)
    except PermissionError:
        raise Fail(f"cannot create {parent}. Run once:  sudo mkdir -p {parent} && sudo chown $USER {parent}")
    staging = parent / f".unpacking-{os.getpid()}"
    shutil.rmtree(staging, ignore_errors=True)
    staging.mkdir()
    try:
        with tarfile.open(archive, "r:gz") as t:
            members = t.getmembers()
            bad = [m.name for m in members if not (m.name == "lean" or m.name.startswith("lean/"))
                   or ".." in m.name.split("/") or not (m.isfile() or m.isdir())]
            if bad:
                raise Fail(f"archive has unexpected entries, refusing to unpack: {bad[:3]}")
            kw = {"filter": "data"} if hasattr(tarfile, "data_filter") else {}
            t.extractall(staging, members=members, **kw)
        (staging / "lean").rename(folder)
    finally:
        shutil.rmtree(staging, ignore_errors=True)


def ensure_elan():
    elan = which("elan")
    if elan:
        return elan
    print("installing elan (the Lean version manager) from github.com/leanprover/elan")
    init = Path(os.environ.get("TMPDIR", "/tmp")) / f"elan-init-{os.getpid()}.sh"
    req = urllib.request.Request("https://raw.githubusercontent.com/leanprover/elan/master/elan-init.sh",
                                 headers={"User-Agent": USER_AGENT})
    with urllib.request.urlopen(req, timeout=120) as r:
        init.write_bytes(r.read())
    try:
        if run(["sh", str(init), "-y", "--default-toolchain", "none"]).returncode != 0:
            raise Fail("elan install failed")
    finally:
        init.unlink(missing_ok=True)
    elan = which("elan")
    if not elan:
        raise Fail("elan installed but not found in ~/.elan/bin")
    return elan


def toolchain_installed(elan: str, toolchain: str = TOOLCHAIN) -> bool:
    out = subprocess.run([elan, "toolchain", "list"], capture_output=True, text=True, env=lean_env()).stdout
    return any(l.split()[0] == toolchain for l in out.splitlines() if l.strip())


def mathlib_cache_present(folder: Path) -> bool:
